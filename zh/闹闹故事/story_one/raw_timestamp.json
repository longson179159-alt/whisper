[
    {
        "start": 0.0,
        "end": 1.9000000000000001,
        "text": "闹闹的怪病"
    },
    {
        "start": 3.64,
        "end": 6.54,
        "text": "最近我得了一种怪病"
    },
    {
        "start": 6.54,
        "end": 9.38,
        "text": "这个病的名字叫糊涂"
    },
    {
        "start": 9.38,
        "end": 13.120000000000001,
        "text": "我在一个月内不见了四个水壶"
    },
    {
        "start": 13.120000000000001,
        "end": 14.48,
        "text": "三个钱包"
    },
    {
        "start": 14.48,
        "end": 17.02,
        "text": "两本像图书馆借的书"
    },
    {
        "start": 17.02,
        "end": 19.02,
        "text": "还有一双校鞋"
    },
    {
        "start": 20.82,
        "end": 23.7,
        "text": "我的校鞋是在学校不见的"
    },
    {
        "start": 23.7,
        "end": 26.6,
        "text": "那天我们在学校踢足球"
    },
    {
        "start": 26.6,
        "end": 29.36,
        "text": "当我举起脚大力踢球时"
    },
    {
        "start": 29.52,
        "end": 32.12,
        "text": "我的鞋子因为鞋带松了"
    },
    {
        "start": 32.12,
        "end": 34.12,
        "text": "飞到泥巴后面"
    },
    {
        "start": 35.8,
        "end": 38.9,
        "text": "我赶紧跑到泥巴后面找我的鞋"
    },
    {
        "start": 38.9,
        "end": 42.14,
        "text": "可是找了老半天还是找不到"
    },
    {
        "start": 42.14,
        "end": 44.7,
        "text": "我只好左脚穿着鞋子"
    },
    {
        "start": 44.7,
        "end": 47.18,
        "text": "右脚穿着袜子回家"
    },
    {
        "start": 49.18,
        "end": 51.34,
        "text": "妈妈生气的对我说"
    },
    {
        "start": 51.34,
        "end": 54.120000000000005,
        "text": "你连穿在脚上的鞋子都能弄丢"
    },
    {
        "start": 54.120000000000005,
        "end": 55.78,
        "text": "真是太厉害了"
    },
    {
        "start": 55.78,
        "end": 57.879999999999995,
        "text": "我笑嘻嘻地回答妈妈"
    },
    {
        "start": 58.1,
        "end": 60.18,
        "text": "谢谢夸奖"
    },
    {
        "start": 60.18,
        "end": 61.82,
        "text": "妈妈更生气了"
    },
    {
        "start": 61.82,
        "end": 62.74,
        "text": "骂道"
    },
    {
        "start": 62.74,
        "end": 63.88,
        "text": "我是在骂你"
    },
    {
        "start": 63.88,
        "end": 65.38,
        "text": "不是称赞你"
    },
    {
        "start": 65.38,
        "end": 67.74000000000001,
        "text": "鞋带松了应该绑紧"
    },
    {
        "start": 67.74000000000001,
        "end": 69.78,
        "text": "你又懒惰又糊涂"
    },
    {
        "start": 69.78,
        "end": 71.32000000000001,
        "text": "迟早会闯祸"
    },
    {
        "start": 71.32000000000001,
        "end": 74.52000000000001,
        "text": "但是我没把妈妈的话放在心上"
    },
    {
        "start": 76.72,
        "end": 79.82000000000001,
        "text": "这天妈妈给了我五十块钱"
    },
    {
        "start": 79.82000000000001,
        "end": 83.16,
        "text": "叫我去杂货店买米和番茄酱"
    },
    {
        "start": 83.16,
        "end": 85.36,
        "text": "妈妈吩咐我要小心"
    },
    {
        "start": 85.36,
        "end": 86.84,
        "text": "别糊里糊涂"
    },
    {
        "start": 86.86,
        "end": 88.7,
        "text": "我充满信心的回答"
    },
    {
        "start": 88.7,
        "end": 89.5,
        "text": "放心吧"
    },
    {
        "start": 89.5,
        "end": 90.0,
        "text": "妈妈"
    },
    {
        "start": 92.2,
        "end": 94.3,
        "text": "在走去杂货店的途中"
    },
    {
        "start": 94.3,
        "end": 95.98,
        "text": "我遇见了阿火"
    },
    {
        "start": 95.98,
        "end": 97.98,
        "text": "他正好要到干洗店"
    },
    {
        "start": 97.98,
        "end": 101.06,
        "text": "帮妈妈领回送去干洗的碗装"
    },
    {
        "start": 101.06,
        "end": 102.9,
        "text": "我们于是结伴同行"
    },
    {
        "start": 105.14,
        "end": 107.5,
        "text": "阿火发现我的鞋带松了"
    },
    {
        "start": 107.5,
        "end": 108.5,
        "text": "便说"
    },
    {
        "start": 108.5,
        "end": 109.18,
        "text": "囊囊"
    },
    {
        "start": 109.18,
        "end": 110.9,
        "text": "你的鞋带松了"
    },
    {
        "start": 110.9,
        "end": 112.82000000000001,
        "text": "我想起妈妈的话"
    },
    {
        "start": 112.82000000000001,
        "end": 115.16,
        "text": "鞋带松了要绑好"
    },
    {
        "start": 115.17999999999999,
        "end": 117.1,
        "text": "于是马上蹲下来"
    },
    {
        "start": 117.1,
        "end": 118.06,
        "text": "把他绑好"
    },
    {
        "start": 120.25999999999999,
        "end": 122.14,
        "text": "我洋洋得意的想"
    },
    {
        "start": 122.14,
        "end": 124.14,
        "text": "我回去要告诉妈妈"
    },
    {
        "start": 124.14,
        "end": 126.7,
        "text": "他就不会再说我糊涂了"
    },
    {
        "start": 126.7,
        "end": 128.5,
        "text": "我踩着轻快的脚步"
    },
    {
        "start": 128.5,
        "end": 130.14,
        "text": "和阿火走向商店"
    },
    {
        "start": 132.38,
        "end": 134.78,
        "text": "阿火拿了他妈妈的碗装"
    },
    {
        "start": 134.78,
        "end": 136.7,
        "text": "便来杂货店找我"
    },
    {
        "start": 136.7,
        "end": 138.78,
        "text": "我拿了米和番茄酱"
    },
    {
        "start": 138.78,
        "end": 140.3,
        "text": "准备付钱时"
    },
    {
        "start": 140.3,
        "end": 143.1,
        "text": "发现我的五十块钱不见了"
    },
    {
        "start": 143.1,
        "end": 144.98,
        "text": "我紧张的问阿火"
    },
    {
        "start": 145.0,
        "end": 146.56,
        "text": "你有没有看见我的钱"
    },
    {
        "start": 147.48,
        "end": 148.39999999999998,
        "text": "阿火说"
    },
    {
        "start": 148.39999999999998,
        "end": 150.07999999999998,
        "text": "会不会掉在路上"
    },
    {
        "start": 150.07999999999998,
        "end": 153.67999999999998,
        "text": "这时我突然想起刚才绑鞋带的事"
    },
    {
        "start": 153.67999999999998,
        "end": 154.64,
        "text": "喊道"
    },
    {
        "start": 154.64,
        "end": 157.2,
        "text": "一定是我绑鞋带的时候掉了"
    },
    {
        "start": 157.2,
        "end": 159.2,
        "text": "我们连忙奔出杂货店"
    },
    {
        "start": 161.39999999999998,
        "end": 164.88,
        "text": "我从远处便看见行人道上的钞票"
    },
    {
        "start": 164.88,
        "end": 166.76,
        "text": "连忙飞奔过去"
    },
    {
        "start": 166.76,
        "end": 169.07999999999998,
        "text": "忽然一阵风吹来"
    },
    {
        "start": 169.07999999999998,
        "end": 171.64,
        "text": "我的五十块钱被风吹走了"
    },
    {
        "start": 171.64,
        "end": 173.1,
        "text": "好不容易"
    },
    {
        "start": 173.1,
        "end": 175.38,
        "text": "风终于停止了"
    },
    {
        "start": 175.38,
        "end": 177.7,
        "text": "钞票不偏不倚的"
    },
    {
        "start": 177.7,
        "end": 180.89999999999998,
        "text": "掉入了行人道旁边的小水沟里"
    },
    {
        "start": 180.89999999999998,
        "end": 181.7,
        "text": "哎呀"
    },
    {
        "start": 181.7,
        "end": 182.7,
        "text": "糟糕"
    },
    {
        "start": 182.7,
        "end": 184.14,
        "text": "我大叫起来"
    },
    {
        "start": 184.14,
        "end": 184.89999999999998,
        "text": "别怕"
    },
    {
        "start": 184.89999999999998,
        "end": 186.29999999999998,
        "text": "我的手比较瘦"
    },
    {
        "start": 186.29999999999998,
        "end": 187.5,
        "text": "我帮你拿"
    },
    {
        "start": 187.5,
        "end": 189.17999999999998,
        "text": "阿火勇敢的说"
    },
    {
        "start": 191.17999999999998,
        "end": 193.33999999999997,
        "text": "阿火把碗装交给我"
    },
    {
        "start": 193.33999999999997,
        "end": 195.73999999999998,
        "text": "便把手伸入小水沟里"
    },
    {
        "start": 195.73999999999998,
        "end": 197.38,
        "text": "我紧张的追问"
    },
    {
        "start": 197.38,
        "end": 198.29999999999998,
        "text": "拿到了吗"
    },
    {
        "start": 198.29999999999998,
        "end": 199.38,
        "text": "拿到了吗"
    },
    {
        "start": 199.38,
        "end": 200.29999999999998,
        "text": "阿火说"
    },
    {
        "start": 200.36,
        "end": 201.64000000000001,
        "text": "拿到了吗"
    },
    {
        "start": 201.64000000000001,
        "end": 204.84,
        "text": "阿火全神贯注的把手伸进去"
    },
    {
        "start": 204.84,
        "end": 206.0,
        "text": "努力的挖着"
    },
    {
        "start": 208.70000000000002,
        "end": 209.8,
        "text": "找到了"
    },
    {
        "start": 209.8,
        "end": 211.24,
        "text": "阿火欢呼道"
    },
    {
        "start": 211.24,
        "end": 215.10000000000002,
        "text": "这时一辆电单车从我们身边驶过"
    },
    {
        "start": 215.10000000000002,
        "end": 217.8,
        "text": "轮子碾过了阿姨的碗装"
    },
    {
        "start": 217.8,
        "end": 219.10000000000002,
        "text": "我吓坏了"
    },
    {
        "start": 219.10000000000002,
        "end": 220.84,
        "text": "连忙拉起碗装"
    },
    {
        "start": 220.84,
        "end": 222.70000000000002,
        "text": "碗装被我这么一拉"
    },
    {
        "start": 222.70000000000002,
        "end": 223.96,
        "text": "撕成了两半"
    },
    {
        "start": 226.20000000000002,
        "end": 228.36,
        "text": "我和阿火都呆住了"
    },
    {
        "start": 228.36,
        "end": 229.64000000000001,
        "text": "过了一会"
    },
    {
        "start": 229.7,
        "end": 232.04,
        "text": "阿火怒气冲冲的说"
    },
    {
        "start": 232.04,
        "end": 232.77999999999997,
        "text": "闹闹"
    },
    {
        "start": 232.77999999999997,
        "end": 234.2,
        "text": "你干的好事"
    },
    {
        "start": 234.2,
        "end": 236.64,
        "text": "我妈妈的碗装值几百块钱"
    },
    {
        "start": 236.64,
        "end": 238.14,
        "text": "你赔得起吗"
    },
    {
        "start": 238.14,
        "end": 239.17999999999998,
        "text": "说完"
    },
    {
        "start": 239.17999999999998,
        "end": 241.14,
        "text": "阿火便生气的离开"
    },
    {
        "start": 243.33999999999997,
        "end": 244.54,
        "text": "回到家里"
    },
    {
        "start": 244.54,
        "end": 247.83999999999997,
        "text": "我把事情一五一十的告诉妈妈"
    },
    {
        "start": 247.83999999999997,
        "end": 249.79999999999998,
        "text": "妈妈生气的骂道"
    },
    {
        "start": 249.79999999999998,
        "end": 251.27999999999997,
        "text": "我早就说过"
    },
    {
        "start": 251.27999999999997,
        "end": 253.79999999999998,
        "text": "如果你不改掉你这糊涂的个性"
    },
    {
        "start": 253.79999999999998,
        "end": 255.7,
        "text": "迟早会闯大祸"
    },
    {
        "start": 255.7,
        "end": 257.78,
        "text": "我心里好后悔"
    },
    {
        "start": 257.78,
        "end": 260.32,
        "text": "如果我不粗心就好了"
    },
    {
        "start": 262.52,
        "end": 263.52,
        "text": "当晚"
    },
    {
        "start": 263.52,
        "end": 265.53999999999996,
        "text": "妈妈带我到阿火家"
    },
    {
        "start": 265.53999999999996,
        "end": 267.23999999999995,
        "text": "向阿姨道歉"
    },
    {
        "start": 267.23999999999995,
        "end": 271.52,
        "text": "阿姨心疼的望着她被撕成两半的碗装"
    },
    {
        "start": 271.52,
        "end": 274.17999999999995,
        "text": "虽然她笑着说没关系"
    },
    {
        "start": 274.17999999999995,
        "end": 277.82,
        "text": "但我觉得她的样子比哭还难看"
    },
    {
        "start": 280.03999999999996,
        "end": 281.03999999999996,
        "text": "第二天"
    },
    {
        "start": 281.03999999999996,
        "end": 282.64,
        "text": "黄老师告诉我们"
    },
    {
        "start": 282.64,
        "end": 285.64,
        "text": "学校要带我们参观印度庙"
    },
    {
        "start": 285.7,
        "end": 288.3,
        "text": "体验新加坡的多元文化"
    },
    {
        "start": 288.3,
        "end": 289.97999999999996,
        "text": "我们听了非常高兴"
    },
    {
        "start": 292.18,
        "end": 293.84,
        "text": "出发的前一天"
    },
    {
        "start": 293.84,
        "end": 295.64,
        "text": "妈妈吩咐我说"
    },
    {
        "start": 295.64,
        "end": 297.24,
        "text": "不能再糊涂了"
    },
    {
        "start": 297.24,
        "end": 299.3,
        "text": "你一共带了六样东西"
    },
    {
        "start": 299.3,
        "end": 300.59999999999997,
        "text": "数给我听"
    },
    {
        "start": 300.59999999999997,
        "end": 301.84,
        "text": "我回答"
    },
    {
        "start": 301.84,
        "end": 302.94,
        "text": "雨伞"
    },
    {
        "start": 302.94,
        "end": 304.18,
        "text": "水壶"
    },
    {
        "start": 304.18,
        "end": 305.53999999999996,
        "text": "钱包"
    },
    {
        "start": 305.53999999999996,
        "end": 306.9,
        "text": "纸巾"
    },
    {
        "start": 306.9,
        "end": 308.34,
        "text": "只有四样啊"
    },
    {
        "start": 310.58,
        "end": 311.74,
        "text": "妈妈说"
    },
    {
        "start": 311.74,
        "end": 313.44,
        "text": "书包不必算啊"
    },
    {
        "start": 313.44,
        "end": 314.18,
        "text": "还有"
    },
    {
        "start": 314.18,
        "end": 315.64,
        "text": "别忘了鞋子"
    },
    {
        "start": 315.64,
        "end": 316.34000000000003,
        "text": "哈哈"
    },
    {
        "start": 316.34000000000003,
        "end": 318.14,
        "text": "书包背在身上"
    },
    {
        "start": 318.14,
        "end": 320.08,
        "text": "鞋子穿在脚下"
    },
    {
        "start": 320.08,
        "end": 322.42,
        "text": "我怎么可能会忘记呢"
    },
    {
        "start": 322.42,
        "end": 324.48,
        "text": "妈妈对我太没信心了"
    },
    {
        "start": 326.72,
        "end": 327.84000000000003,
        "text": "在校车上"
    },
    {
        "start": 327.84000000000003,
        "end": 329.48,
        "text": "黄老师提醒我们"
    },
    {
        "start": 329.48,
        "end": 333.32,
        "text": "无论到哪里都必须和伙伴在一起"
    },
    {
        "start": 333.32,
        "end": 334.54,
        "text": "互相照应"
    },
    {
        "start": 334.54,
        "end": 336.42,
        "text": "我开心的对阿火说"
    },
    {
        "start": 336.42,
        "end": 337.62,
        "text": "你是我的伙伴"
    },
    {
        "start": 338.58,
        "end": 340.72,
        "text": "阿火却不怎么高兴"
    },
    {
        "start": 340.72,
        "end": 341.68,
        "text": "他说"
    },
    {
        "start": 341.74,
        "end": 344.64,
        "text": "我怕你的怪病会把我害惨"
    },
    {
        "start": 344.64,
        "end": 346.44,
        "text": "我不明白他的意思"
    },
    {
        "start": 346.44,
        "end": 347.38,
        "text": "便问"
    },
    {
        "start": 347.38,
        "end": 349.04,
        "text": "什么怪病"
    },
    {
        "start": 349.04,
        "end": 350.54,
        "text": "糊涂啊"
    },
    {
        "start": 350.54,
        "end": 352.48,
        "text": "我哈哈大笑说"
    },
    {
        "start": 352.48,
        "end": 354.14,
        "text": "我不会再糊涂了"
    },
    {
        "start": 355.18,
        "end": 356.58,
        "text": "闹闹的怪病"
    },
    {
        "start": 358.78000000000003,
        "end": 361.12,
        "text": "我们抵达印度庙之后"
    },
    {
        "start": 361.12,
        "end": 364.84000000000003,
        "text": "老师提醒大家集合的时间和地点"
    },
    {
        "start": 364.84000000000003,
        "end": 365.98,
        "text": "还说"
    },
    {
        "start": 365.98,
        "end": 367.82,
        "text": "如果大家真的走失了"
    },
    {
        "start": 367.82,
        "end": 369.04,
        "text": "不要惊慌"
    },
    {
        "start": 369.04,
        "end": 370.92,
        "text": "到庙的后门等候"
    },
    {
        "start": 370.92,
        "end": 374.38,
        "text": "因为校车会在那里接我们"
    },
    {
        "start": 374.38,
        "end": 377.16,
        "text": "印度庙好大好漂亮"
    },
    {
        "start": 377.16,
        "end": 380.12,
        "text": "大家进去之前必须脱鞋子"
    },
    {
        "start": 380.12,
        "end": 382.66,
        "text": "我怕我会忘记我的鞋子"
    },
    {
        "start": 382.66,
        "end": 385.08000000000004,
        "text": "便把鞋子放进书包里"
    },
    {
        "start": 385.08000000000004,
        "end": 387.88,
        "text": "然后和大家一起走进庙里"
    },
    {
        "start": 390.08000000000004,
        "end": 392.96000000000004,
        "text": "当庙宇的负责人在做讲解时"
    },
    {
        "start": 392.96000000000004,
        "end": 394.78000000000003,
        "text": "我忽然觉得尿急"
    },
    {
        "start": 394.78000000000003,
        "end": 396.26,
        "text": "便对黄老师说"
    },
    {
        "start": 396.26,
        "end": 397.02000000000004,
        "text": "老师"
    },
    {
        "start": 397.02000000000004,
        "end": 398.46000000000004,
        "text": "我想上厕所"
    },
    {
        "start": 398.46000000000004,
        "end": 399.78000000000003,
        "text": "老师不放心"
    },
    {
        "start": 399.84,
        "end": 402.17999999999995,
        "text": "叫阿火陪我去"
    },
    {
        "start": 402.17999999999995,
        "end": 403.71999999999997,
        "text": "我快忍不住了"
    },
    {
        "start": 403.71999999999997,
        "end": 406.11999999999995,
        "text": "看到了厕所便冲进去"
    },
    {
        "start": 406.11999999999995,
        "end": 409.02,
        "text": "厕所里面有几个印度女人"
    },
    {
        "start": 409.02,
        "end": 411.52,
        "text": "她们看到我都很吃惊"
    },
    {
        "start": 411.52,
        "end": 413.97999999999996,
        "text": "我心里想奇怪"
    },
    {
        "start": 413.97999999999996,
        "end": 416.82,
        "text": "怎么印度阿姨喜欢上男厕所"
    },
    {
        "start": 419.03999999999996,
        "end": 421.78,
        "text": "这时我听到阿火的声音"
    },
    {
        "start": 421.78,
        "end": 422.21999999999997,
        "text": "喂"
    },
    {
        "start": 422.21999999999997,
        "end": 422.94,
        "text": "糊涂虫"
    },
    {
        "start": 422.94,
        "end": 424.78,
        "text": "你进了女厕所"
    },
    {
        "start": 424.78,
        "end": 426.94,
        "text": "可是我真的太急了"
    },
    {
        "start": 426.94,
        "end": 428.28,
        "text": "顾不了这么多"
    },
    {
        "start": 428.28,
        "end": 429.38,
        "text": "小便了再说"
    },
    {
        "start": 431.58,
        "end": 434.84,
        "text": "当我厚着脸皮从女厕所走出来时"
    },
    {
        "start": 434.84,
        "end": 437.28,
        "text": "却发现阿火不见了"
    },
    {
        "start": 437.28,
        "end": 438.88,
        "text": "我到处找阿火"
    },
    {
        "start": 438.88,
        "end": 440.21999999999997,
        "text": "还是找不到他"
    },
    {
        "start": 442.41999999999996,
        "end": 444.17999999999995,
        "text": "我赶紧回去大殿"
    },
    {
        "start": 444.17999999999995,
        "end": 445.61999999999995,
        "text": "想要报告黄老师"
    },
    {
        "start": 445.61999999999995,
        "end": 447.23999999999995,
        "text": "阿火不见了"
    },
    {
        "start": 447.23999999999995,
        "end": 449.02,
        "text": "当我把鞋子脱了"
    },
    {
        "start": 449.02,
        "end": 451.34,
        "text": "想再次装入书包里时"
    },
    {
        "start": 451.34,
        "end": 455.58,
        "text": "这才发现书包竟然是开着的"
    },
    {
        "start": 455.58,
        "end": 458.14,
        "text": "我的书包是几时打开的"
    },
    {
        "start": 458.2,
        "end": 459.9,
        "text": "啊 我知道了"
    },
    {
        "start": 459.9,
        "end": 462.24,
        "text": "一定是我要上厕所时"
    },
    {
        "start": 462.24,
        "end": 464.59999999999997,
        "text": "从书包里拿出鞋子"
    },
    {
        "start": 464.59999999999997,
        "end": 467.59999999999997,
        "text": "然后忘记拉上书包的拉链"
    },
    {
        "start": 467.59999999999997,
        "end": 470.34,
        "text": "我连忙数一数里面的东西"
    },
    {
        "start": 470.34,
        "end": 472.47999999999996,
        "text": "发现只剩下雨伞"
    },
    {
        "start": 474.59999999999997,
        "end": 478.0,
        "text": "我紧张地到处找我丢失的东西"
    },
    {
        "start": 478.0,
        "end": 480.74,
        "text": "可是怎么找都找不着"
    },
    {
        "start": 480.74,
        "end": 482.3,
        "text": "更糟糕的是"
    },
    {
        "start": 482.3,
        "end": 484.0,
        "text": "等我回到大殿时"
    },
    {
        "start": 484.0,
        "end": 487.0,
        "text": "连黄老师和同学们都不在了"
    },
    {
        "start": 489.0,
        "end": 490.9,
        "text": "我开始感到惊慌"
    },
    {
        "start": 490.9,
        "end": 493.4,
        "text": "为什么大家都不见了呢"
    },
    {
        "start": 493.4,
        "end": 496.74,
        "text": "这时我想起黄老师刚才说过"
    },
    {
        "start": 496.74,
        "end": 498.7,
        "text": "如果真的走失了"
    },
    {
        "start": 498.7,
        "end": 500.09999999999997,
        "text": "就要我们到"
    },
    {
        "start": 500.09999999999997,
        "end": 502.5,
        "text": "到 到哪里集合呢"
    },
    {
        "start": 504.4,
        "end": 507.8,
        "text": "哎呀 为什么我刚才没听清楚"
    },
    {
        "start": 507.8,
        "end": 509.8,
        "text": "我真是个糊涂虫"
    },
    {
        "start": 509.8,
        "end": 511.4,
        "text": "我责骂自己"
    },
    {
        "start": 511.4,
        "end": 514.5,
        "text": "我决定到刚才下校车的地方"
    },
    {
        "start": 514.5,
        "end": 516.8,
        "text": "希望校车会在那里"
    },
    {
        "start": 517.4599999999999,
        "end": 519.9599999999999,
        "text": "我来到了庙的前门"
    },
    {
        "start": 519.9599999999999,
        "end": 522.5999999999999,
        "text": "只见马路上车水马龙"
    },
    {
        "start": 522.5999999999999,
        "end": 525.8,
        "text": "并没有看见任何校车停在那里"
    },
    {
        "start": 525.8,
        "end": 527.3599999999999,
        "text": "我感到很害怕"
    },
    {
        "start": 529.4599999999999,
        "end": 531.06,
        "text": "我连忙对自己说"
    },
    {
        "start": 531.06,
        "end": 532.8,
        "text": "镇定 镇定"
    },
    {
        "start": 532.8,
        "end": 534.6999999999999,
        "text": "我是个十岁的孩子"
    },
    {
        "start": 534.6999999999999,
        "end": 536.8599999999999,
        "text": "一定能想到办法回家"
    },
    {
        "start": 536.8599999999999,
        "end": 538.4599999999999,
        "text": "对了 打电话"
    },
    {
        "start": 538.4599999999999,
        "end": 541.1999999999999,
        "text": "可是我的钱包不见了"
    },
    {
        "start": 541.1999999999999,
        "end": 543.76,
        "text": "我没有钱打电话"
    },
    {
        "start": 543.76,
        "end": 546.56,
        "text": "老天爷一点也不同情我"
    },
    {
        "start": 546.56,
        "end": 549.1199999999999,
        "text": "竟然在这时下起大雨"
    },
    {
        "start": 549.1199999999999,
        "end": 551.8199999999999,
        "text": "我想打开书包拿出雨伞"
    },
    {
        "start": 551.8199999999999,
        "end": 553.1199999999999,
        "text": "这才发现"
    },
    {
        "start": 553.1199999999999,
        "end": 556.3199999999999,
        "text": "我把书包和雨伞留在殿堂外"
    },
    {
        "start": 558.4599999999999,
        "end": 560.8199999999999,
        "text": "大雨打在我的身上"
    },
    {
        "start": 560.8199999999999,
        "end": 562.4599999999999,
        "text": "非常疼痛"
    },
    {
        "start": 562.4599999999999,
        "end": 564.6199999999999,
        "text": "于是我开始奔跑"
    },
    {
        "start": 564.6199999999999,
        "end": 566.76,
        "text": "想找个地方避雨"
    },
    {
        "start": 566.76,
        "end": 569.42,
        "text": "可是雨势太大了"
    },
    {
        "start": 569.42,
        "end": 572.06,
        "text": "不久我全身都湿了"
    },
    {
        "start": 573.06,
        "end": 576.2199999999999,
        "text": "这时我看见一个老婆婆"
    },
    {
        "start": 576.2199999999999,
        "end": 578.2199999999999,
        "text": "她手里拿着手机"
    },
    {
        "start": 578.2199999999999,
        "end": 580.2199999999999,
        "text": "我急忙上前问她"
    },
    {
        "start": 580.2199999999999,
        "end": 583.2199999999999,
        "text": "婆婆 我能借用您的电话吗"
    },
    {
        "start": 583.2199999999999,
        "end": 585.2199999999999,
        "text": "老婆婆生气地说"
    },
    {
        "start": 585.2199999999999,
        "end": 587.2199999999999,
        "text": "你要抢我的电话"
    },
    {
        "start": 587.2199999999999,
        "end": 590.2199999999999,
        "text": "我才不会这么笨让你抢"
    },
    {
        "start": 592.2199999999999,
        "end": 595.2199999999999,
        "text": "哎 老婆婆好像是耳聋"
    },
    {
        "start": 595.2199999999999,
        "end": 598.02,
        "text": "或者是雨势太大了"
    },
    {
        "start": 598.02,
        "end": 600.2199999999999,
        "text": "她听不清楚我的话"
    },
    {
        "start": 600.38,
        "end": 603.38,
        "text": "我决定到警察局求助"
    },
    {
        "start": 603.38,
        "end": 606.38,
        "text": "可是警察局在哪里呢"
    },
    {
        "start": 606.38,
        "end": 608.38,
        "text": "我走了很久"
    },
    {
        "start": 608.38,
        "end": 610.38,
        "text": "越走越害怕"
    },
    {
        "start": 610.38,
        "end": 613.38,
        "text": "终于哇啊的哭了起来"
    },
    {
        "start": 613.38,
        "end": 617.38,
        "text": "这时我听见一把温和的声音对我说"
    },
    {
        "start": 617.38,
        "end": 619.38,
        "text": "小弟弟 你为什么哭"
    },
    {
        "start": 619.38,
        "end": 621.38,
        "text": "我抬头一看"
    },
    {
        "start": 621.38,
        "end": 623.38,
        "text": "是个警察叔叔"
    },
    {
        "start": 623.38,
        "end": 625.38,
        "text": "我全身一软"
    },
    {
        "start": 625.38,
        "end": 627.38,
        "text": "哭得更大声了"
    },
    {
        "start": 627.54,
        "end": 630.54,
        "text": "我把地址告诉警察叔叔"
    },
    {
        "start": 630.54,
        "end": 633.54,
        "text": "警察叔叔用警车送我回家"
    },
    {
        "start": 633.54,
        "end": 635.54,
        "text": "我第一次坐上警车"
    },
    {
        "start": 635.54,
        "end": 637.54,
        "text": "感觉好威风啊"
    },
    {
        "start": 637.54,
        "end": 641.54,
        "text": "突然间我觉得自己好像长大了"
    },
    {
        "start": 643.54,
        "end": 644.54,
        "text": "到家时"
    },
    {
        "start": 644.54,
        "end": 648.54,
        "text": "黄老师 阿火 爸爸和妈妈"
    },
    {
        "start": 648.54,
        "end": 650.54,
        "text": "都在门口等着我"
    },
    {
        "start": 650.54,
        "end": 652.54,
        "text": "妈妈流着眼泪冲过来"
    },
    {
        "start": 652.54,
        "end": 654.54,
        "text": "紧紧地抱住我"
    },
    {
        "start": 654.6999999999999,
        "end": 655.6999999999999,
        "text": "紧紧地抱住我"
    },
    {
        "start": 655.6999999999999,
        "end": 657.6999999999999,
        "text": "阿火说"
    },
    {
        "start": 657.6999999999999,
        "end": 659.6999999999999,
        "text": "闹闹 你去了哪里"
    },
    {
        "start": 659.6999999999999,
        "end": 662.6999999999999,
        "text": "我从厕所出来就看不到你了"
    },
    {
        "start": 664.6999999999999,
        "end": 666.6999999999999,
        "text": "爸爸把我教训了一顿"
    },
    {
        "start": 666.6999999999999,
        "end": 668.6999999999999,
        "text": "妈妈流着泪说"
    },
    {
        "start": 668.6999999999999,
        "end": 670.6999999999999,
        "text": "回来就好 回来就好"
    },
    {
        "start": 670.6999999999999,
        "end": 672.6999999999999,
        "text": "我很气自己"
    },
    {
        "start": 672.6999999999999,
        "end": 674.6999999999999,
        "text": "因为我的糊涂"
    },
    {
        "start": 674.6999999999999,
        "end": 676.6999999999999,
        "text": "害妈妈这么担心"
    },
    {
        "start": 676.6999999999999,
        "end": 678.6999999999999,
        "text": "阿火羡慕地说"
    },
    {
        "start": 678.6999999999999,
        "end": 680.6999999999999,
        "text": "坐警车真威风"
    },
    {
        "start": 680.6999999999999,
        "end": 681.6999999999999,
        "text": "我也要坐警车"
    },
    {
        "start": 681.6999999999999,
        "end": 683.6999999999999,
        "text": "警察叔叔笑着说"
    },
    {
        "start": 683.86,
        "end": 685.86,
        "text": "坐警车可不是好事哦"
    },
    {
        "start": 687.86,
        "end": 688.86,
        "text": "回到家里"
    },
    {
        "start": 688.86,
        "end": 690.86,
        "text": "妈妈吃惊地问我"
    },
    {
        "start": 690.86,
        "end": 692.86,
        "text": "你的书包呢"
    },
    {
        "start": 692.86,
        "end": 694.86,
        "text": "我不好意思地说"
    },
    {
        "start": 694.86,
        "end": 696.86,
        "text": "妈妈 六样东西"
    },
    {
        "start": 696.86,
        "end": 698.86,
        "text": "我丢失了五样"
    },
    {
        "start": 698.86,
        "end": 700.86,
        "text": "妈妈叹了口气 摇摇头"
    },
    {
        "start": 702.86,
        "end": 704.86,
        "text": "我决定改掉我的怪病"
    },
    {
        "start": 704.86,
        "end": 706.86,
        "text": "我在房间的墙壁上"
    },
    {
        "start": 706.86,
        "end": 708.86,
        "text": "贴了很多纸条"
    },
    {
        "start": 708.86,
        "end": 710.86,
        "text": "上面都写着"
    },
    {
        "start": 710.86,
        "end": 712.86,
        "text": "我不再糊涂了"
    },
    {
        "start": 713.02,
        "end": 715.02,
        "text": "每天上学之前"
    },
    {
        "start": 715.02,
        "end": 717.02,
        "text": "我都会望一望墙上的纸条"
    },
    {
        "start": 717.02,
        "end": 719.02,
        "text": "提醒自己"
    },
    {
        "start": 719.02,
        "end": 721.02,
        "text": "要改掉这个缺点"
    },
    {
        "start": 723.02,
        "end": 725.02,
        "text": "爸爸为了鼓励我"
    },
    {
        "start": 725.02,
        "end": 727.02,
        "text": "送了一本非常精美的"
    },
    {
        "start": 727.02,
        "end": 729.02,
        "text": "济世本子给我"
    },
    {
        "start": 729.02,
        "end": 731.02,
        "text": "让我记下每天需要做的事情"
    },
    {
        "start": 731.02,
        "end": 733.02,
        "text": "慢慢地"
    },
    {
        "start": 733.02,
        "end": 735.02,
        "text": "我糊涂的怪病就改过来了"
    },
    {
        "start": 737.02,
        "end": 739.02,
        "text": "可是这回却轮到阿火"
    },
    {
        "start": 739.02,
        "end": 741.02,
        "text": "感染了我的怪病"
    },
    {
        "start": 741.18,
        "end": 743.18,
        "text": "我只忘记这个忘记那个"
    },
    {
        "start": 743.18,
        "end": 745.18,
        "text": "阿火的妈妈向我求助"
    },
    {
        "start": 745.18,
        "end": 747.18,
        "text": "说"
    },
    {
        "start": 747.18,
        "end": 749.18,
        "text": "闹闹 请你帮阿火改掉糊涂的毛病吧"
    },
    {
        "start": 751.18,
        "end": 753.18,
        "text": "我找阿火问个清楚"
    },
    {
        "start": 753.18,
        "end": 755.18,
        "text": "阿火悄悄地对我说"
    },
    {
        "start": 755.18,
        "end": 757.18,
        "text": "嘘 别告诉我妈妈"
    },
    {
        "start": 757.18,
        "end": 759.18,
        "text": "我很想坐警车"
    },
    {
        "start": 759.18,
        "end": 761.18,
        "text": "我是假装糊涂"
    },
    {
        "start": 761.18,
        "end": 763.18,
        "text": "希望有一天我会迷路"
    },
    {
        "start": 763.18,
        "end": 765.18,
        "text": "被警察送回家"
    }
]