[
    {
        "start": 0.0,
        "end": 2.3000000000000003,
        "text": "闹闹与土豆"
    },
    {
        "start": 4.0200000000000005,
        "end": 10.38,
        "text": "假期快到了,学校要选一些同学到北京参加进儒活动,"
    },
    {
        "start": 10.38,
        "end": 14.280000000000001,
        "text": "伟伟、宝宝和我都被选中了,"
    },
    {
        "start": 14.280000000000001,
        "end": 17.86,
        "text": "没有被选中的阿火十分羡慕我们。"
    },
    {
        "start": 19.580000000000002,
        "end": 23.98,
        "text": "阿火很想去,于是尝试说服郭老师,"
    },
    {
        "start": 23.98,
        "end": 29.82,
        "text": "老师,你应该给我一个机会,因为我最能代表新加坡,"
    },
    {
        "start": 30.52,
        "end": 35.24,
        "text": "郭老师感到莫名其妙,阿火叫老师摸摸他的头,"
    },
    {
        "start": 35.24,
        "end": 39.6,
        "text": "说,您看我的发型像不像榴莲壳,"
    },
    {
        "start": 39.6,
        "end": 43.32,
        "text": "跟滨海艺术中心一样,可以代表新加坡。"
    },
    {
        "start": 45.52,
        "end": 50.6,
        "text": "郭老师听了哈哈大笑,答应给阿火一个机会,"
    },
    {
        "start": 50.6,
        "end": 53.88,
        "text": "只要阿火成功通过一项口试,"
    },
    {
        "start": 53.88,
        "end": 59.480000000000004,
        "text": "证明自己的华语表达能力,就能跟我们一起出国,"
    },
    {
        "start": 59.5,
        "end": 63.099999999999994,
        "text": "阿火非常认真地为口试做准备,"
    },
    {
        "start": 63.099999999999994,
        "end": 65.25999999999999,
        "text": "皇天不负有心人,"
    },
    {
        "start": 65.25999999999999,
        "end": 69.66,
        "text": "口试时,阿火的表现优异,终于成功过关。"
    },
    {
        "start": 71.86,
        "end": 75.17999999999999,
        "text": "出发前,妈妈帮我收拾行李,"
    },
    {
        "start": 75.17999999999999,
        "end": 79.46,
        "text": "她为我准备了很多冬装,我觉得很好笑,"
    },
    {
        "start": 79.46,
        "end": 86.02,
        "text": "说,妈妈,现在才十月,不会下雪的,不用带冬装了,"
    },
    {
        "start": 86.03999999999999,
        "end": 90.03999999999999,
        "text": "妈妈不放心,说,一防万一吧,"
    },
    {
        "start": 90.03999999999999,
        "end": 92.84,
        "text": "我不要,同学会笑我的,"
    },
    {
        "start": 92.84,
        "end": 98.44,
        "text": "我怕被同学取笑,无论如何都不肯把冬装带去。"
    },
    {
        "start": 98.44,
        "end": 103.64,
        "text": "出发当天,同学们的爸爸妈妈都到机场来送行,"
    },
    {
        "start": 103.64,
        "end": 105.84,
        "text": "妈妈紧紧地抱住我,"
    },
    {
        "start": 105.84,
        "end": 108.03999999999999,
        "text": "好像怕我不再回来,"
    },
    {
        "start": 108.03999999999999,
        "end": 110.6,
        "text": "她依依不舍地说,闹闹,"
    },
    {
        "start": 110.6,
        "end": 114.24,
        "text": "妈妈不在身边,你要好好照顾自己,"
    },
    {
        "start": 114.25999999999999,
        "end": 116.25999999999999,
        "text": "我匆匆回答,知道了。"
    },
    {
        "start": 118.46,
        "end": 122.78,
        "text": "我悄悄地告诉阿火,没有妈妈在身边管着我,"
    },
    {
        "start": 122.78,
        "end": 126.25999999999999,
        "text": "我太开心了,阿火也兴奋地说,"
    },
    {
        "start": 126.25999999999999,
        "end": 132.06,
        "text": "对呀,不必听妈妈的唠叨,我的耳朵一定很舒服。"
    },
    {
        "start": 132.06,
        "end": 134.85999999999999,
        "text": "飞机飞行了大约六个小时,"
    },
    {
        "start": 134.85999999999999,
        "end": 137.01999999999998,
        "text": "我们终于抵达北京,"
    },
    {
        "start": 137.01999999999998,
        "end": 139.94,
        "text": "北京的街道又宽又长,"
    },
    {
        "start": 139.94,
        "end": 141.9,
        "text": "有很多建筑物,"
    },
    {
        "start": 141.92000000000002,
        "end": 145.8,
        "text": "负责带领我们的是来自北京的汪老师,"
    },
    {
        "start": 145.8,
        "end": 150.8,
        "text": "他笑着告诉我们,北京比新加坡大很多倍呢,"
    },
    {
        "start": 152.8,
        "end": 156.08,
        "text": "哇,我们一口同声惊叹,"
    },
    {
        "start": 156.08,
        "end": 158.92000000000002,
        "text": "接着汪老师考我们,"
    },
    {
        "start": 158.92000000000002,
        "end": 162.12,
        "text": "你们知道北京最出名的是什么?"
    },
    {
        "start": 164.12,
        "end": 168.0,
        "text": "大家一口同声地说,万里长城,"
    },
    {
        "start": 168.0,
        "end": 171.4,
        "text": "只有我回答,北京烤鸭,"
    },
    {
        "start": 171.9,
        "end": 173.9,
        "text": "大家听了哈哈大笑,"
    },
    {
        "start": 173.9,
        "end": 174.9,
        "text": "汪老师说,"
    },
    {
        "start": 174.9,
        "end": 177.9,
        "text": "据说从太空上看地球,"
    },
    {
        "start": 177.9,
        "end": 181.9,
        "text": "唯一可以看到的建筑物就是万里长城,"
    },
    {
        "start": 181.9,
        "end": 184.9,
        "text": "哇,真是太神奇了。"
    },
    {
        "start": 186.9,
        "end": 190.9,
        "text": "汪老师安排我们到北京同学的家做课,"
    },
    {
        "start": 190.9,
        "end": 192.9,
        "text": "体验当地的生活,"
    },
    {
        "start": 192.9,
        "end": 193.9,
        "text": "汪老师说,"
    },
    {
        "start": 193.9,
        "end": 195.9,
        "text": "这是一个难得的机会,"
    },
    {
        "start": 195.9,
        "end": 198.9,
        "text": "你们要跟北京的同学好好相处,"
    },
    {
        "start": 198.9,
        "end": 200.9,
        "text": "成为好朋友,"
    },
    {
        "start": 201.4,
        "end": 205.4,
        "text": "同学们都迫不及待想与北京的朋友见面,"
    },
    {
        "start": 205.4,
        "end": 208.4,
        "text": "巴士行驶了约一个多小时,"
    },
    {
        "start": 208.4,
        "end": 210.4,
        "text": "同学们陆续下车,"
    },
    {
        "start": 210.4,
        "end": 213.4,
        "text": "到各自的北京朋友的家去,"
    },
    {
        "start": 213.4,
        "end": 215.4,
        "text": "这时我想上厕所,"
    },
    {
        "start": 215.4,
        "end": 219.4,
        "text": "便趁汪老师送宝宝到其北京朋友的家时,"
    },
    {
        "start": 219.4,
        "end": 221.4,
        "text": "连忙下车找厕所。"
    },
    {
        "start": 223.4,
        "end": 225.4,
        "text": "我找了很久,"
    },
    {
        "start": 225.4,
        "end": 227.4,
        "text": "还是找不到厕所,"
    },
    {
        "start": 227.4,
        "end": 229.4,
        "text": "于是向一位老公公问路,"
    },
    {
        "start": 229.9,
        "end": 231.9,
        "text": "请问厕所在哪里?"
    },
    {
        "start": 231.9,
        "end": 233.9,
        "text": "老公公回答,"
    },
    {
        "start": 233.9,
        "end": 235.9,
        "text": "向东走一站路,"
    },
    {
        "start": 235.9,
        "end": 237.9,
        "text": "再向南一转就是了。"
    },
    {
        "start": 239.9,
        "end": 241.9,
        "text": "我觉得很奇怪,"
    },
    {
        "start": 241.9,
        "end": 245.9,
        "text": "怎么老公公说的话我一句都听不懂,"
    },
    {
        "start": 245.9,
        "end": 247.9,
        "text": "由于我急着找厕所,"
    },
    {
        "start": 247.9,
        "end": 249.9,
        "text": "结果一个不留神,"
    },
    {
        "start": 249.9,
        "end": 252.9,
        "text": "撞到了一个骑着脚踏车的男孩,"
    },
    {
        "start": 252.9,
        "end": 254.9,
        "text": "男孩呱呱叫,"
    },
    {
        "start": 254.9,
        "end": 256.9,
        "text": "你这人咋不看路呀?"
    },
    {
        "start": 257.4,
        "end": 259.4,
        "text": "我一直找不到厕所,"
    },
    {
        "start": 259.4,
        "end": 261.4,
        "text": "就快要忍不住了,"
    },
    {
        "start": 261.4,
        "end": 264.4,
        "text": "这时我发现地上有一个塑料瓶,"
    },
    {
        "start": 264.4,
        "end": 266.4,
        "text": "我灵机一动,"
    },
    {
        "start": 266.4,
        "end": 269.4,
        "text": "决定把塑料瓶当做临时尿壶。"
    },
    {
        "start": 271.4,
        "end": 273.4,
        "text": "男孩瞪大眼睛,"
    },
    {
        "start": 273.4,
        "end": 275.4,
        "text": "生气地叫道,"
    },
    {
        "start": 275.4,
        "end": 277.4,
        "text": "你,你怎么在我的水壶里撒尿?"
    },
    {
        "start": 277.4,
        "end": 279.4,
        "text": "我吓了一跳,"
    },
    {
        "start": 279.4,
        "end": 281.4,
        "text": "不好意思地说,"
    },
    {
        "start": 281.4,
        "end": 283.4,
        "text": "对不起,"
    },
    {
        "start": 283.4,
        "end": 285.4,
        "text": "我不知道这瓶子是你的,"
    },
    {
        "start": 285.4,
        "end": 287.4,
        "text": "我赶快溜走。"
    },
    {
        "start": 288.9,
        "end": 290.4,
        "text": "回到巴士上,"
    },
    {
        "start": 290.4,
        "end": 291.9,
        "text": "阿火告诉我,"
    },
    {
        "start": 291.9,
        "end": 293.9,
        "text": "他的北京朋友生病了,"
    },
    {
        "start": 293.9,
        "end": 295.9,
        "text": "所以他会和我同住,"
    },
    {
        "start": 295.9,
        "end": 297.9,
        "text": "有阿火与我做伴,"
    },
    {
        "start": 297.9,
        "end": 299.9,
        "text": "我太高兴了。"
    },
    {
        "start": 299.9,
        "end": 301.9,
        "text": "巴士行驶没多远,"
    },
    {
        "start": 301.9,
        "end": 304.9,
        "text": "就在一间老屋子前停下,"
    },
    {
        "start": 304.9,
        "end": 307.9,
        "text": "一个奶奶站在门口迎接我们。"
    },
    {
        "start": 308.9,
        "end": 310.9,
        "text": "汪老师对我们说,"
    },
    {
        "start": 310.9,
        "end": 312.9,
        "text": "这是土豆的家,"
    },
    {
        "start": 312.9,
        "end": 314.9,
        "text": "她是土豆的奶奶,"
    },
    {
        "start": 314.9,
        "end": 317.4,
        "text": "但是北京话不容易听懂,"
    },
    {
        "start": 317.4,
        "end": 319.4,
        "text": "你们要注意听。"
    },
    {
        "start": 319.4,
        "end": 321.4,
        "text": "阿火悄悄地对我说,"
    },
    {
        "start": 321.4,
        "end": 323.4,
        "text": "北京话不难懂,"
    },
    {
        "start": 323.4,
        "end": 325.4,
        "text": "每句话后面加个儿子就对了。"
    },
    {
        "start": 327.4,
        "end": 329.4,
        "text": "汪老师离开后,"
    },
    {
        "start": 329.4,
        "end": 331.4,
        "text": "奶奶说话了,"
    },
    {
        "start": 331.4,
        "end": 333.4,
        "text": "哎,我说,"
    },
    {
        "start": 333.4,
        "end": 335.4,
        "text": "你们俩别愣着了,"
    },
    {
        "start": 335.4,
        "end": 337.4,
        "text": "快进屋吧。"
    },
    {
        "start": 337.4,
        "end": 339.4,
        "text": "奶奶一开口说话,"
    },
    {
        "start": 339.4,
        "end": 341.4,
        "text": "我就明白阿火的意思了。"
    },
    {
        "start": 341.4,
        "end": 343.4,
        "text": "阿火对我说,"
    },
    {
        "start": 343.9,
        "end": 345.9,
        "text": "好奇怪的名字。"
    },
    {
        "start": 345.9,
        "end": 347.9,
        "text": "我笑嘻嘻地说,"
    },
    {
        "start": 347.9,
        "end": 349.9,
        "text": "可能他长得像豆,"
    },
    {
        "start": 349.9,
        "end": 351.9,
        "text": "又很土。"
    },
    {
        "start": 351.9,
        "end": 353.9,
        "text": "这时,"
    },
    {
        "start": 353.9,
        "end": 355.9,
        "text": "传来一把声音,"
    },
    {
        "start": 355.9,
        "end": 357.9,
        "text": "谁土了?"
    },
    {
        "start": 357.9,
        "end": 359.9,
        "text": "土豆是北京话,"
    },
    {
        "start": 359.9,
        "end": 361.9,
        "text": "是马铃薯的意思。"
    },
    {
        "start": 361.9,
        "end": 363.9,
        "text": "我和阿火回头一看,"
    },
    {
        "start": 363.9,
        "end": 365.9,
        "text": "原来是刚才那个骑脚踏车的男孩。"
    },
    {
        "start": 365.9,
        "end": 367.9,
        "text": "奶奶开心地介绍,"
    },
    {
        "start": 367.9,
        "end": 369.9,
        "text": "他就是土豆了。"
    },
    {
        "start": 369.9,
        "end": 371.9,
        "text": "奶奶又问我们,"
    },
    {
        "start": 372.4,
        "end": 374.4,
        "text": "你们叫啥名来着?"
    },
    {
        "start": 374.4,
        "end": 376.4,
        "text": "我们呆呆地望着奶奶,"
    },
    {
        "start": 376.4,
        "end": 378.4,
        "text": "阿火说,"
    },
    {
        "start": 378.4,
        "end": 380.4,
        "text": "傻?我们才不傻。"
    },
    {
        "start": 380.4,
        "end": 382.4,
        "text": "土豆笑着说,"
    },
    {
        "start": 382.4,
        "end": 384.4,
        "text": "还说不傻?"
    },
    {
        "start": 384.4,
        "end": 386.4,
        "text": "傻是咱们北京话,"
    },
    {
        "start": 386.4,
        "end": 388.4,
        "text": "什么的意思?"
    },
    {
        "start": 388.4,
        "end": 390.4,
        "text": "一见面就笑人家傻,"
    },
    {
        "start": 390.4,
        "end": 392.4,
        "text": "这土豆真讨厌。"
    },
    {
        "start": 392.4,
        "end": 394.4,
        "text": "奶奶带我们"
    },
    {
        "start": 394.4,
        "end": 396.4,
        "text": "进院子里参观,"
    },
    {
        "start": 396.4,
        "end": 398.4,
        "text": "她说,"
    },
    {
        "start": 398.4,
        "end": 400.4,
        "text": "这院叫四合院,"
    },
    {
        "start": 400.9,
        "end": 402.9,
        "text": "是我们历史了,"
    },
    {
        "start": 402.9,
        "end": 404.9,
        "text": "是咱们祖先留下的。"
    },
    {
        "start": 404.9,
        "end": 406.9,
        "text": "奶奶,"
    },
    {
        "start": 406.9,
        "end": 408.9,
        "text": "为什么叫四合院?"
    },
    {
        "start": 408.9,
        "end": 410.9,
        "text": "我问,"
    },
    {
        "start": 410.9,
        "end": 412.9,
        "text": "土豆抢着回答,"
    },
    {
        "start": 412.9,
        "end": 414.9,
        "text": "哈哈,还说不傻,"
    },
    {
        "start": 414.9,
        "end": 416.9,
        "text": "四合院的四字是指"
    },
    {
        "start": 416.9,
        "end": 418.9,
        "text": "东南西北四面,"
    },
    {
        "start": 418.9,
        "end": 420.9,
        "text": "和是围在一起的意思。"
    },
    {
        "start": 420.9,
        "end": 422.9,
        "text": "奶奶骂土豆,"
    },
    {
        "start": 422.9,
        "end": 424.9,
        "text": "快打住,没礼貌,"
    },
    {
        "start": 424.9,
        "end": 426.9,
        "text": "你们哥几个快进屋吧,"
    },
    {
        "start": 426.9,
        "end": 428.9,
        "text": "我去弄点吃的。"
    },
    {
        "start": 428.9,
        "end": 430.9,
        "text": "奶奶说的话,我只听懂一半,"
    },
    {
        "start": 430.9,
        "end": 432.9,
        "text": "原来,"
    },
    {
        "start": 432.9,
        "end": 434.9,
        "text": "这四合院里住了很多人,"
    },
    {
        "start": 434.9,
        "end": 436.9,
        "text": "土豆和奶奶,"
    },
    {
        "start": 436.9,
        "end": 438.9,
        "text": "是住在其中一间屋子里,"
    },
    {
        "start": 438.9,
        "end": 440.9,
        "text": "土豆带我们参观她的房间,"
    },
    {
        "start": 440.9,
        "end": 442.9,
        "text": "她的房间很简单,"
    },
    {
        "start": 442.9,
        "end": 444.9,
        "text": "但是很干净。"
    },
    {
        "start": 446.9,
        "end": 448.9,
        "text": "闹闹与土豆,"
    },
    {
        "start": 450.9,
        "end": 452.9,
        "text": "吃了晚饭,"
    },
    {
        "start": 452.9,
        "end": 454.9,
        "text": "土豆帮奶奶洗碗,"
    },
    {
        "start": 454.9,
        "end": 456.9,
        "text": "我拿了衣服要去冲凉,"
    },
    {
        "start": 456.9,
        "end": 458.9,
        "text": "土豆问,干啥?"
    },
    {
        "start": 458.9,
        "end": 460.9,
        "text": "我猜想,"
    },
    {
        "start": 460.9,
        "end": 462.9,
        "text": "干啥的意思,"
    },
    {
        "start": 462.9,
        "end": 464.9,
        "text": "是做什么?"
    },
    {
        "start": 464.9,
        "end": 466.9,
        "text": "于是回答,冲凉啊,"
    },
    {
        "start": 466.9,
        "end": 468.9,
        "text": "土豆皱了皱眉头,"
    },
    {
        "start": 468.9,
        "end": 470.9,
        "text": "冲凉?是洗澡吧?"
    },
    {
        "start": 472.9,
        "end": 474.9,
        "text": "我看了土豆一眼,"
    },
    {
        "start": 474.9,
        "end": 476.9,
        "text": "说,都一样啦,"
    },
    {
        "start": 476.9,
        "end": 478.9,
        "text": "我们习惯说冲凉,"
    },
    {
        "start": 478.9,
        "end": 480.9,
        "text": "我们每天都冲凉,"
    },
    {
        "start": 480.9,
        "end": 482.9,
        "text": "有时,一天还冲两次呢,"
    },
    {
        "start": 482.9,
        "end": 484.9,
        "text": "土豆说,"
    },
    {
        "start": 484.9,
        "end": 486.9,
        "text": "也对,像你这种到处小便的人,"
    },
    {
        "start": 486.9,
        "end": 488.9,
        "text": "一天洗两次澡还不够呢,"
    },
    {
        "start": 488.9,
        "end": 490.9,
        "text": "哈哈,"
    },
    {
        "start": 490.9,
        "end": 492.9,
        "text": "哪像咱们,冬天里"
    },
    {
        "start": 492.9,
        "end": 494.9,
        "text": "一个星期洗一次澡就行了。"
    },
    {
        "start": 496.9,
        "end": 498.9,
        "text": "我不理土豆,心里想,"
    },
    {
        "start": 498.9,
        "end": 500.9,
        "text": "这人好脏啊,"
    },
    {
        "start": 500.9,
        "end": 502.9,
        "text": "我走进浴室,"
    },
    {
        "start": 502.9,
        "end": 504.9,
        "text": "脱掉衣服准备冲凉,"
    },
    {
        "start": 504.9,
        "end": 506.9,
        "text": "好冷啊,"
    },
    {
        "start": 506.9,
        "end": 508.9,
        "text": "我咬了水往身上一淋,"
    },
    {
        "start": 508.9,
        "end": 510.9,
        "text": "哇,这水就好像冰一样,"
    },
    {
        "start": 510.9,
        "end": 512.9,
        "text": "我忍不住大叫起来,"
    },
    {
        "start": 512.9,
        "end": 514.9,
        "text": "这时,"
    },
    {
        "start": 514.9,
        "end": 516.9,
        "text": "有人敲门,"
    },
    {
        "start": 516.9,
        "end": 518.9,
        "text": "我抱着毛巾,全身发抖去开门,"
    },
    {
        "start": 518.9,
        "end": 520.9,
        "text": "门外是提着"
    },
    {
        "start": 520.9,
        "end": 522.9,
        "text": "热水壶的土豆,"
    },
    {
        "start": 522.9,
        "end": 524.9,
        "text": "他一看到我这副模样,"
    },
    {
        "start": 524.9,
        "end": 526.9,
        "text": "就哈哈大笑,"
    },
    {
        "start": 526.9,
        "end": 528.9,
        "text": "说,怎么样,还冲凉吗?"
    },
    {
        "start": 528.9,
        "end": 530.9,
        "text": "是不是越冲越凉?"
    },
    {
        "start": 530.9,
        "end": 532.9,
        "text": "土豆一边说,"
    },
    {
        "start": 532.9,
        "end": 534.9,
        "text": "一边把热水倒进木盆里,"
    },
    {
        "start": 534.9,
        "end": 536.9,
        "text": "我冷得直发抖,"
    },
    {
        "start": 536.9,
        "end": 538.9,
        "text": "瞪着土豆,"
    },
    {
        "start": 538.9,
        "end": 540.9,
        "text": "说不出话,"
    },
    {
        "start": 540.9,
        "end": 542.9,
        "text": "瞪着土豆,说不出话来,"
    },
    {
        "start": 544.9,
        "end": 546.9,
        "text": "晚上天气很冷,"
    },
    {
        "start": 546.9,
        "end": 548.9,
        "text": "阿火穿上所有的衣服,"
    },
    {
        "start": 548.9,
        "end": 550.9,
        "text": "我就惨了,"
    },
    {
        "start": 550.9,
        "end": 552.9,
        "text": "带的衣服不多,"
    },
    {
        "start": 552.9,
        "end": 554.9,
        "text": "冷得直发抖,"
    },
    {
        "start": 554.9,
        "end": 556.9,
        "text": "这时土豆给我一条棉被,"
    },
    {
        "start": 556.9,
        "end": 558.9,
        "text": "嬉皮笑脸的说,"
    },
    {
        "start": 558.9,
        "end": 560.9,
        "text": "哈哈,很冷吧,"
    },
    {
        "start": 560.9,
        "end": 562.9,
        "text": "需要这个吗?"
    },
    {
        "start": 562.9,
        "end": 564.9,
        "text": "这土豆真讨厌,"
    },
    {
        "start": 564.9,
        "end": 566.9,
        "text": "总是取笑我,"
    },
    {
        "start": 566.9,
        "end": 568.9,
        "text": "我要有骨气,"
    },
    {
        "start": 568.9,
        "end": 570.9,
        "text": "无论如何都不能收下它的棉被,"
    },
    {
        "start": 570.9,
        "end": 572.9,
        "text": "于是我拒绝了土豆,"
    },
    {
        "start": 572.9,
        "end": 574.9,
        "text": "土豆笑嘻嘻的说,"
    },
    {
        "start": 574.9,
        "end": 576.9,
        "text": "不要后悔哦,"
    },
    {
        "start": 576.9,
        "end": 578.9,
        "text": "到了半夜会更冷,"
    },
    {
        "start": 578.9,
        "end": 580.9,
        "text": "我生气的说,"
    },
    {
        "start": 580.9,
        "end": 582.9,
        "text": "绝不后悔,"
    },
    {
        "start": 582.9,
        "end": 584.9,
        "text": "我只后悔住在你家里,"
    },
    {
        "start": 584.9,
        "end": 586.9,
        "text": "真倒霉,"
    },
    {
        "start": 586.9,
        "end": 588.9,
        "text": "半夜里实在太冷了,"
    },
    {
        "start": 588.9,
        "end": 590.9,
        "text": "我紧紧的抱着阿火,"
    },
    {
        "start": 590.9,
        "end": 592.9,
        "text": "两个人翻来覆去都睡不着,"
    },
    {
        "start": 592.9,
        "end": 594.9,
        "text": "哎,"
    },
    {
        "start": 594.9,
        "end": 596.9,
        "text": "如果是冷气机就好了,"
    },
    {
        "start": 596.9,
        "end": 598.9,
        "text": "关了就没事,"
    },
    {
        "start": 598.9,
        "end": 600.9,
        "text": "原来,"
    },
    {
        "start": 600.9,
        "end": 602.9,
        "text": "冷的感觉是这么可怕的,"
    },
    {
        "start": 604.9,
        "end": 606.9,
        "text": "第二天,"
    },
    {
        "start": 606.9,
        "end": 608.9,
        "text": "奶奶说要带我和阿火去万里长城,"
    },
    {
        "start": 608.9,
        "end": 610.9,
        "text": "我们四人来到了长城脚下,"
    },
    {
        "start": 610.9,
        "end": 612.9,
        "text": "哇,"
    },
    {
        "start": 612.9,
        "end": 614.9,
        "text": "长城好壮观啊,"
    },
    {
        "start": 614.9,
        "end": 616.9,
        "text": "它好像一条龙,"
    },
    {
        "start": 616.9,
        "end": 618.9,
        "text": "弯弯曲曲的,"
    },
    {
        "start": 618.9,
        "end": 620.9,
        "text": "躺在很多山上,"
    },
    {
        "start": 620.9,
        "end": 622.9,
        "text": "土豆告诉我们,"
    },
    {
        "start": 622.9,
        "end": 624.9,
        "text": "咱们这儿有句话,"
    },
    {
        "start": 624.9,
        "end": 626.9,
        "text": "不到长城非好汉,"
    },
    {
        "start": 626.9,
        "end": 628.9,
        "text": "你们能当好汉吗?"
    },
    {
        "start": 628.9,
        "end": 630.9,
        "text": "阿火得意的对土豆说,"
    },
    {
        "start": 630.9,
        "end": 632.9,
        "text": "你这么矮,"
    },
    {
        "start": 632.9,
        "end": 634.9,
        "text": "闹闹又这么胖,"
    },
    {
        "start": 634.9,
        "end": 636.9,
        "text": "看样子,"
    },
    {
        "start": 636.9,
        "end": 638.9,
        "text": "只有我能当好汉了,"
    },
    {
        "start": 638.9,
        "end": 640.9,
        "text": "于是,"
    },
    {
        "start": 640.9,
        "end": 642.9,
        "text": "我们决定比赛,"
    },
    {
        "start": 642.9,
        "end": 644.9,
        "text": "谁先到达第一个风火台,"
    },
    {
        "start": 644.9,
        "end": 646.9,
        "text": "谁就是好汉。"
    },
    {
        "start": 646.9,
        "end": 648.9,
        "text": "风火台,"
    },
    {
        "start": 648.9,
        "end": 650.9,
        "text": "是为了不让敌人入侵而建的,"
    },
    {
        "start": 650.9,
        "end": 652.9,
        "text": "长城上,"
    },
    {
        "start": 652.9,
        "end": 654.9,
        "text": "长城上有很多风火台,"
    },
    {
        "start": 654.9,
        "end": 656.9,
        "text": "如果白天有敌人进攻,"
    },
    {
        "start": 656.9,
        "end": 658.9,
        "text": "风火台就会放烟,"
    },
    {
        "start": 658.9,
        "end": 660.9,
        "text": "如果敌人是在夜里进攻,"
    },
    {
        "start": 660.9,
        "end": 662.9,
        "text": "风火台就会点燃火焰,"
    },
    {
        "start": 662.9,
        "end": 664.9,
        "text": "士兵们就是以这样的方式互通信息,"
    },
    {
        "start": 664.9,
        "end": 666.9,
        "text": "第一个风火台看起来就在附近,"
    },
    {
        "start": 666.9,
        "end": 668.9,
        "text": "可是很奇怪,"
    },
    {
        "start": 668.9,
        "end": 670.9,
        "text": "我们走了很久都还没到达。"
    },
    {
        "start": 670.9,
        "end": 672.9,
        "text": "长城很陡峭,"
    },
    {
        "start": 672.9,
        "end": 674.9,
        "text": "梯级又高,"
    },
    {
        "start": 674.9,
        "end": 676.9,
        "text": "高度很高,"
    },
    {
        "start": 676.9,
        "end": 678.9,
        "text": "高度很高,"
    },
    {
        "start": 678.9,
        "end": 680.9,
        "text": "高度很高,"
    },
    {
        "start": 680.9,
        "end": 682.9,
        "text": "梯级又高又窄,"
    },
    {
        "start": 682.9,
        "end": 684.9,
        "text": "土豆虽然矮小,"
    },
    {
        "start": 684.9,
        "end": 686.9,
        "text": "但是爬得很快,"
    },
    {
        "start": 686.9,
        "end": 688.9,
        "text": "一下子就不见踪影,"
    },
    {
        "start": 688.9,
        "end": 690.9,
        "text": "我和阿火吃力地爬着,"
    },
    {
        "start": 690.9,
        "end": 692.9,
        "text": "阿火上气不接下气地说,"
    },
    {
        "start": 692.9,
        "end": 694.9,
        "text": "闹闹,"
    },
    {
        "start": 694.9,
        "end": 696.9,
        "text": "我不当好汉了,"
    },
    {
        "start": 696.9,
        "end": 698.9,
        "text": "我放弃了。"
    },
    {
        "start": 700.9,
        "end": 702.9,
        "text": "我回答,"
    },
    {
        "start": 702.9,
        "end": 704.9,
        "text": "不行,"
    },
    {
        "start": 704.9,
        "end": 706.9,
        "text": "输了很没面子的,"
    },
    {
        "start": 706.9,
        "end": 708.9,
        "text": "想到又要被土豆取笑,"
    },
    {
        "start": 708.9,
        "end": 710.9,
        "text": "但无论如何都要当好汉,"
    },
    {
        "start": 710.9,
        "end": 712.9,
        "text": "就在这时,"
    },
    {
        "start": 712.9,
        "end": 714.9,
        "text": "我不小心摔了一跤,"
    },
    {
        "start": 714.9,
        "end": 716.9,
        "text": "整个人跌坐在地上,"
    },
    {
        "start": 716.9,
        "end": 718.9,
        "text": "我的脚好像扭伤了,"
    },
    {
        "start": 718.9,
        "end": 720.9,
        "text": "好痛啊!"
    },
    {
        "start": 722.9,
        "end": 724.9,
        "text": "我痛得眼泪都流出来了,"
    },
    {
        "start": 724.9,
        "end": 726.9,
        "text": "这时阿火也慌了,"
    },
    {
        "start": 726.9,
        "end": 728.9,
        "text": "着急地问,"
    },
    {
        "start": 728.9,
        "end": 730.9,
        "text": "怎么办,要不要打电话给汪老师?"
    },
    {
        "start": 730.9,
        "end": 732.9,
        "text": "这时,"
    },
    {
        "start": 732.9,
        "end": 734.9,
        "text": "土豆突然走回来,"
    },
    {
        "start": 734.9,
        "end": 736.9,
        "text": "问,你咋坐在地上,"
    },
    {
        "start": 736.9,
        "end": 738.9,
        "text": "不比赛了吗?"
    },
    {
        "start": 740.9,
        "end": 742.9,
        "text": "阿火告诉土豆,我跌倒了,"
    },
    {
        "start": 742.9,
        "end": 744.9,
        "text": "我心里想,"
    },
    {
        "start": 744.9,
        "end": 746.9,
        "text": "这下子什么面子都丢光了,"
    },
    {
        "start": 746.9,
        "end": 748.9,
        "text": "笑吧,"
    },
    {
        "start": 748.9,
        "end": 750.9,
        "text": "尽管笑我吧!"
    },
    {
        "start": 750.9,
        "end": 752.9,
        "text": "可是土豆却关心地问我,"
    },
    {
        "start": 752.9,
        "end": 754.9,
        "text": "很痛吗?"
    },
    {
        "start": 754.9,
        "end": 756.9,
        "text": "别担心,我背你下去。"
    },
    {
        "start": 756.9,
        "end": 758.9,
        "text": "说完,土豆"
    },
    {
        "start": 758.9,
        "end": 760.9,
        "text": "就好像大力士那样,"
    },
    {
        "start": 760.9,
        "end": 762.9,
        "text": "把我背起来,"
    },
    {
        "start": 762.9,
        "end": 764.9,
        "text": "一步一步地走着,"
    },
    {
        "start": 764.9,
        "end": 766.9,
        "text": "我心里的背着我,"
    },
    {
        "start": 766.9,
        "end": 768.9,
        "text": "连耳朵都红了,"
    },
    {
        "start": 768.9,
        "end": 770.9,
        "text": "我心里很感动。"
    },
    {
        "start": 772.9,
        "end": 774.9,
        "text": "奶奶在长城脚下等我们,"
    },
    {
        "start": 774.9,
        "end": 776.9,
        "text": "她看见我们这个样子,"
    },
    {
        "start": 776.9,
        "end": 778.9,
        "text": "吓坏了,"
    },
    {
        "start": 778.9,
        "end": 780.9,
        "text": "她赶紧叫人来帮忙,"
    },
    {
        "start": 780.9,
        "end": 782.9,
        "text": "把我抬到德士里,"
    },
    {
        "start": 782.9,
        "end": 784.9,
        "text": "阿火对土豆竖起拇指,"
    },
    {
        "start": 784.9,
        "end": 786.9,
        "text": "说,你真是一个好汉!"
    },
    {
        "start": 788.9,
        "end": 790.9,
        "text": "回到四合院时,"
    },
    {
        "start": 790.9,
        "end": 792.9,
        "text": "我的脚已经很肿了,"
    },
    {
        "start": 792.9,
        "end": 794.9,
        "text": "奶奶在我受伤的脚上"
    },
    {
        "start": 794.9,
        "end": 796.9,
        "text": "涂抹药酒,"
    },
    {
        "start": 796.9,
        "end": 798.9,
        "text": "她一边涂,一边推拿,"
    },
    {
        "start": 798.9,
        "end": 800.9,
        "text": "我痛得眼泪都流出来了。"
    },
    {
        "start": 804.9,
        "end": 806.9,
        "text": "到了晚上,天气变得更冷,"
    },
    {
        "start": 806.9,
        "end": 808.9,
        "text": "我全身发抖,"
    },
    {
        "start": 808.9,
        "end": 810.9,
        "text": "觉得自己快要生病了,"
    },
    {
        "start": 810.9,
        "end": 812.9,
        "text": "这时,土豆给我们带来了棉被,"
    },
    {
        "start": 812.9,
        "end": 814.9,
        "text": "真奇怪,"
    },
    {
        "start": 814.9,
        "end": 816.9,
        "text": "昨天那个讨人厌的土豆,"
    },
    {
        "start": 816.9,
        "end": 818.9,
        "text": "今天变得特别可爱,"
    },
    {
        "start": 818.9,
        "end": 820.9,
        "text": "我们三个人都在那里,"
    },
    {
        "start": 820.9,
        "end": 822.9,
        "text": "我们三个人钻进被窝里,"
    },
    {
        "start": 822.9,
        "end": 824.9,
        "text": "开始聊天,"
    },
    {
        "start": 824.9,
        "end": 826.9,
        "text": "阿火问土豆,"
    },
    {
        "start": 826.9,
        "end": 828.9,
        "text": "怎么没看见你的爸爸妈妈?"
    },
    {
        "start": 828.9,
        "end": 830.9,
        "text": "土豆难过地说,"
    },
    {
        "start": 830.9,
        "end": 832.9,
        "text": "他们都在上海工作,"
    },
    {
        "start": 832.9,
        "end": 834.9,
        "text": "一年才回来两次,"
    },
    {
        "start": 834.9,
        "end": 836.9,
        "text": "奶奶不愿意到上海住,"
    },
    {
        "start": 836.9,
        "end": 838.9,
        "text": "爸爸妈妈让我留下来照顾她。"
    },
    {
        "start": 840.9,
        "end": 842.9,
        "text": "我好奇地问土豆,"
    },
    {
        "start": 842.9,
        "end": 844.9,
        "text": "土豆真的是你的名字吗?"
    },
    {
        "start": 844.9,
        "end": 846.9,
        "text": "土豆笑着说,"
    },
    {
        "start": 846.9,
        "end": 848.9,
        "text": "当然不是,"
    },
    {
        "start": 848.9,
        "end": 850.9,
        "text": "我的名字是黄蓉,"
    },
    {
        "start": 850.9,
        "end": 852.9,
        "text": "因为我很喜欢吃土豆,"
    },
    {
        "start": 852.9,
        "end": 854.9,
        "text": "所以奶奶就给了我这个小名。"
    },
    {
        "start": 858.9,
        "end": 860.9,
        "text": "土豆的年龄和我一样,"
    },
    {
        "start": 860.9,
        "end": 862.9,
        "text": "可是却比我懂事,"
    },
    {
        "start": 862.9,
        "end": 864.9,
        "text": "她不但能照顾自己,"
    },
    {
        "start": 864.9,
        "end": 866.9,
        "text": "还懂得照顾奶奶,"
    },
    {
        "start": 866.9,
        "end": 868.9,
        "text": "不像我,常常惹妈妈生气,"
    },
    {
        "start": 868.9,
        "end": 870.9,
        "text": "我真应该向土豆学习。"
    },
    {
        "start": 872.9,
        "end": 874.9,
        "text": "隔天早上,"
    },
    {
        "start": 874.9,
        "end": 876.9,
        "text": "我被阿火大力摇醒,"
    },
    {
        "start": 876.9,
        "end": 878.9,
        "text": "闹闹快来看,下雪了!"
    },
    {
        "start": 878.9,
        "end": 880.9,
        "text": "我睁开眼睛望向窗外,"
    },
    {
        "start": 880.9,
        "end": 882.9,
        "text": "外头一片白茫茫,"
    },
    {
        "start": 882.9,
        "end": 884.9,
        "text": "雪花从天上轻轻落下,"
    },
    {
        "start": 884.9,
        "end": 886.9,
        "text": "美丽极了!"
    },
    {
        "start": 888.9,
        "end": 890.9,
        "text": "这是我和阿火第一次看到雪,"
    },
    {
        "start": 890.9,
        "end": 892.9,
        "text": "我们非常兴奋,"
    },
    {
        "start": 892.9,
        "end": 894.9,
        "text": "原来下雪是这么漂亮的!"
    },
    {
        "start": 894.9,
        "end": 896.9,
        "text": "土豆拿了一件棉袄给我,"
    },
    {
        "start": 896.9,
        "end": 898.9,
        "text": "说,给,别着凉了!"
    },
    {
        "start": 900.9,
        "end": 902.9,
        "text": "土豆说,"
    },
    {
        "start": 902.9,
        "end": 904.9,
        "text": "我给你一个,"
    },
    {
        "start": 904.9,
        "end": 906.9,
        "text": "别着凉了!"
    },
    {
        "start": 908.9,
        "end": 910.9,
        "text": "不久,巴士来接我们到学校,"
    },
    {
        "start": 910.9,
        "end": 912.9,
        "text": "由于我的脚受伤了,"
    },
    {
        "start": 912.9,
        "end": 914.9,
        "text": "行动不便,"
    },
    {
        "start": 914.9,
        "end": 918.9,
        "text": "土豆不知从哪里借来了拐杖让我使用,"
    },
    {
        "start": 918.9,
        "end": 920.9,
        "text": "我心里有说不出的感动。"
    },
    {
        "start": 922.9,
        "end": 924.9,
        "text": "王老师对大家说,"
    },
    {
        "start": 924.9,
        "end": 926.9,
        "text": "你们真幸运,赶上了北京少见的雪,"
    },
    {
        "start": 926.9,
        "end": 930.9,
        "text": "这可是今年冬天的第一场雪呢!"
    },
    {
        "start": 930.9,
        "end": 932.9,
        "text": "北京的学校很大,"
    },
    {
        "start": 932.9,
        "end": 934.9,
        "text": "同学们都很热情,"
    },
    {
        "start": 934.9,
        "end": 936.9,
        "text": "王老师问班上的同学,"
    },
    {
        "start": 936.9,
        "end": 938.9,
        "text": "大家喜欢新加坡来的朋友吗?"
    },
    {
        "start": 938.9,
        "end": 940.9,
        "text": "同学们大声地回答,"
    },
    {
        "start": 940.9,
        "end": 942.9,
        "text": "喜欢!"
    },
    {
        "start": 942.9,
        "end": 944.9,
        "text": "我发现,"
    },
    {
        "start": 944.9,
        "end": 946.9,
        "text": "他们回答老师的问题时,"
    },
    {
        "start": 946.9,
        "end": 948.9,
        "text": "既大声又主动,"
    },
    {
        "start": 948.9,
        "end": 950.9,
        "text": "学习态度很认真。"
    },
    {
        "start": 952.9,
        "end": 954.9,
        "text": "土豆代表全班,"
    },
    {
        "start": 954.9,
        "end": 956.9,
        "text": "在黑板上写了几个字,"
    },
    {
        "start": 956.9,
        "end": 958.9,
        "text": "有朋友,"
    },
    {
        "start": 958.9,
        "end": 960.9,
        "text": "有朋友自远方来,"
    },
    {
        "start": 960.9,
        "end": 962.9,
        "text": "不亦乐乎。"
    },
    {
        "start": 962.9,
        "end": 964.9,
        "text": "然后对大家说,"
    },
    {
        "start": 964.9,
        "end": 966.9,
        "text": "这句话的意思是,"
    },
    {
        "start": 966.9,
        "end": 968.9,
        "text": "有朋友从很远的地方来,"
    },
    {
        "start": 968.9,
        "end": 970.9,
        "text": "我们非常开心。"
    },
    {
        "start": 972.9,
        "end": 974.9,
        "text": "我和土豆相识而笑,"
    },
    {
        "start": 974.9,
        "end": 976.9,
        "text": "我摸着身上的棉袄,"
    },
    {
        "start": 976.9,
        "end": 978.9,
        "text": "心里特别温暖,"
    },
    {
        "start": 978.9,
        "end": 980.9,
        "text": "土豆真是有情有义,"
    },
    {
        "start": 980.9,
        "end": 982.9,
        "text": "我希望和土豆永远都是好朋友。"
    },
    {
        "start": 982.9,
        "end": 984.9,
        "text": "我希望和土豆永远都是好朋友。"
    }
]