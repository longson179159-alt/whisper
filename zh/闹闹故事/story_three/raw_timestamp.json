[
    {
        "start": 0.0,
        "end": 4.0,
        "text": "闹闹是阅读王"
    },
    {
        "start": 4.0,
        "end": 9.0,
        "text": "最近我和阿火都迷上了日本卡通片"
    },
    {
        "start": 9.0,
        "end": 12.0,
        "text": "阿火时常带光碟来我家"
    },
    {
        "start": 12.0,
        "end": 16.0,
        "text": "我们一边吃零食,一边看卡通片"
    },
    {
        "start": 16.0,
        "end": 20.0,
        "text": "卡通片里的英雄真有本事"
    },
    {
        "start": 20.0,
        "end": 24.0,
        "text": "他骑着一辆蓝色的越野脚踏车"
    },
    {
        "start": 24.0,
        "end": 26.0,
        "text": "到处救人"
    },
    {
        "start": 26.0,
        "end": 30.0,
        "text": "他的脚随便一踢便可以把人踢倒在地上"
    },
    {
        "start": 32.0,
        "end": 36.0,
        "text": "今晚妈妈看见我们一边看卡通片"
    },
    {
        "start": 36.0,
        "end": 39.0,
        "text": "一边模仿里头的人物全打脚踢"
    },
    {
        "start": 39.0,
        "end": 41.0,
        "text": "便把电视关上"
    },
    {
        "start": 41.0,
        "end": 44.0,
        "text": "说这种暴力的卡通片不要看太多"
    },
    {
        "start": 44.0,
        "end": 48.0,
        "text": "你们应该多看些有益的课外书"
    },
    {
        "start": 49.0,
        "end": 53.0,
        "text": "妈妈说完便找出了两本故事书要我们读"
    },
    {
        "start": 53.0,
        "end": 55.0,
        "text": "阿火笑嘻嘻地说"
    },
    {
        "start": 55.0,
        "end": 57.0,
        "text": "我最讨厌看书了"
    },
    {
        "start": 57.0,
        "end": 59.0,
        "text": "我还是回家看光碟"
    },
    {
        "start": 59.0,
        "end": 61.0,
        "text": "我对妈妈说"
    },
    {
        "start": 61.0,
        "end": 63.0,
        "text": "看书很闷的"
    },
    {
        "start": 63.0,
        "end": 64.0,
        "text": "书里都是字"
    },
    {
        "start": 64.0,
        "end": 65.0,
        "text": "不会动"
    },
    {
        "start": 65.0,
        "end": 67.0,
        "text": "也不会发出声音"
    },
    {
        "start": 67.0,
        "end": 69.0,
        "text": "一点都不好玩"
    },
    {
        "start": 69.0,
        "end": 72.0,
        "text": "妈妈板着脸坚持要我看书"
    },
    {
        "start": 74.0,
        "end": 76.0,
        "text": "我翻开故事书"
    },
    {
        "start": 76.0,
        "end": 78.0,
        "text": "可是一个字也看不下"
    },
    {
        "start": 78.0,
        "end": 83.0,
        "text": "书本上的字好像在我面前跳啊跳的"
    },
    {
        "start": 83.0,
        "end": 87.0,
        "text": "我看着看着很快便睡着了"
    },
    {
        "start": 87.0,
        "end": 89.0,
        "text": "我还做了一个梦"
    },
    {
        "start": 89.0,
        "end": 92.0,
        "text": "梦见我是卡通片里的超级英雄呢"
    },
    {
        "start": 93.0,
        "end": 95.0,
        "text": "梦里我变得非常瘦"
    },
    {
        "start": 95.0,
        "end": 96.0,
        "text": "非常英俊"
    },
    {
        "start": 96.0,
        "end": 99.0,
        "text": "我看见故事书向我跑来"
    },
    {
        "start": 99.0,
        "end": 102.0,
        "text": "便用我又瘦又长的脚一踢"
    },
    {
        "start": 102.0,
        "end": 104.0,
        "text": "故事书便飞到天上去了"
    },
    {
        "start": 104.0,
        "end": 106.0,
        "text": "我醒来的时候"
    },
    {
        "start": 106.0,
        "end": 108.0,
        "text": "发现自己躺在地上"
    },
    {
        "start": 108.0,
        "end": 111.0,
        "text": "讨厌的故事书盖在我的头上"
    },
    {
        "start": 111.0,
        "end": 112.0,
        "text": "原来"
    },
    {
        "start": 112.0,
        "end": 113.0,
        "text": "昨天晚上"
    },
    {
        "start": 113.0,
        "end": 115.0,
        "text": "飞起来的不是书"
    },
    {
        "start": 115.0,
        "end": 117.0,
        "text": "而是我自己"
    },
    {
        "start": 118.0,
        "end": 119.0,
        "text": "这天"
    },
    {
        "start": 119.0,
        "end": 121.0,
        "text": "黄老师对我们说"
    },
    {
        "start": 121.0,
        "end": 123.0,
        "text": "为了鼓励大家多看书"
    },
    {
        "start": 123.0,
        "end": 126.0,
        "text": "每个月读最多课外书的同学"
    },
    {
        "start": 126.0,
        "end": 128.0,
        "text": "会被封为小博士"
    },
    {
        "start": 128.0,
        "end": 131.0,
        "text": "并得到一份神秘大礼物"
    },
    {
        "start": 131.0,
        "end": 132.0,
        "text": "休息时"
    },
    {
        "start": 132.0,
        "end": 133.0,
        "text": "伟伟拿着书"
    },
    {
        "start": 133.0,
        "end": 135.0,
        "text": "专心的阅读"
    },
    {
        "start": 135.0,
        "end": 136.0,
        "text": "我取下伟伟"
    },
    {
        "start": 136.0,
        "end": 137.0,
        "text": "喂书呆子"
    },
    {
        "start": 137.0,
        "end": 139.0,
        "text": "不必这么勤劳了"
    },
    {
        "start": 139.0,
        "end": 141.0,
        "text": "你肯定成为小博士的"
    },
    {
        "start": 143.0,
        "end": 144.0,
        "text": "突然"
    },
    {
        "start": 144.0,
        "end": 147.0,
        "text": "一把声音在我背后响起"
    },
    {
        "start": 147.0,
        "end": 148.0,
        "text": "那可不一定"
    },
    {
        "start": 148.0,
        "end": 150.0,
        "text": "小博士可能是我"
    },
    {
        "start": 150.0,
        "end": 152.0,
        "text": "我转头一看"
    },
    {
        "start": 152.0,
        "end": 154.0,
        "text": "原来是阿火"
    },
    {
        "start": 154.0,
        "end": 157.0,
        "text": "他手里竟然拿着一本课外书"
    },
    {
        "start": 157.0,
        "end": 158.0,
        "text": "我看着"
    },
    {
        "start": 158.0,
        "end": 161.0,
        "text": "他手里竟然拿着一本课外书"
    },
    {
        "start": 163.0,
        "end": 164.0,
        "text": "我吃惊的问"
    },
    {
        "start": 164.0,
        "end": 167.0,
        "text": "你不是最讨厌看课外书吗"
    },
    {
        "start": 167.0,
        "end": 169.0,
        "text": "阿火认真的回答"
    },
    {
        "start": 169.0,
        "end": 171.0,
        "text": "我还是讨厌啊"
    },
    {
        "start": 171.0,
        "end": 172.0,
        "text": "我瞪着他"
    },
    {
        "start": 172.0,
        "end": 173.0,
        "text": "不解的问"
    },
    {
        "start": 173.0,
        "end": 175.0,
        "text": "那你为什么还看"
    },
    {
        "start": 175.0,
        "end": 177.0,
        "text": "阿火突然压低声音"
    },
    {
        "start": 177.0,
        "end": 179.0,
        "text": "神秘的说"
    },
    {
        "start": 179.0,
        "end": 180.0,
        "text": "那天"
    },
    {
        "start": 180.0,
        "end": 182.0,
        "text": "我和妈妈在购物中心"
    },
    {
        "start": 182.0,
        "end": 183.0,
        "text": "遇见黄老师"
    },
    {
        "start": 183.0,
        "end": 184.0,
        "text": "他买了一辆"
    },
    {
        "start": 184.0,
        "end": 187.0,
        "text": "很贵的越野脚踏车"
    },
    {
        "start": 187.0,
        "end": 188.0,
        "text": "我还是不明白"
    },
    {
        "start": 188.0,
        "end": 189.0,
        "text": "继续问"
    },
    {
        "start": 189.0,
        "end": 191.0,
        "text": "那又怎样"
    },
    {
        "start": 192.0,
        "end": 194.0,
        "text": "阿火敲我的头"
    },
    {
        "start": 194.0,
        "end": 195.0,
        "text": "说"
    },
    {
        "start": 195.0,
        "end": 196.0,
        "text": "笨蛋"
    },
    {
        "start": 196.0,
        "end": 197.0,
        "text": "我听到黄老师说"
    },
    {
        "start": 197.0,
        "end": 200.0,
        "text": "那是他要送给人的礼物"
    },
    {
        "start": 200.0,
        "end": 202.0,
        "text": "韦韦这时插嘴说"
    },
    {
        "start": 202.0,
        "end": 205.0,
        "text": "我们不应该为了礼物才看书"
    },
    {
        "start": 205.0,
        "end": 206.0,
        "text": "其实"
    },
    {
        "start": 206.0,
        "end": 208.0,
        "text": "看书是很有趣的"
    },
    {
        "start": 210.0,
        "end": 211.0,
        "text": "太好了"
    },
    {
        "start": 211.0,
        "end": 212.0,
        "text": "只要看书"
    },
    {
        "start": 212.0,
        "end": 214.0,
        "text": "就能够得到脚踏车"
    },
    {
        "start": 214.0,
        "end": 216.0,
        "text": "我也要做小博士"
    },
    {
        "start": 216.0,
        "end": 217.0,
        "text": "我大声的说"
    },
    {
        "start": 217.0,
        "end": 219.0,
        "text": "阿火不高兴的回应"
    },
    {
        "start": 219.0,
        "end": 221.0,
        "text": "你要和我抢脚踏车"
    },
    {
        "start": 221.0,
        "end": 223.0,
        "text": "我是不会输给你的"
    },
    {
        "start": 225.0,
        "end": 226.0,
        "text": "我不服气的说"
    },
    {
        "start": 226.0,
        "end": 227.0,
        "text": "比就比"
    },
    {
        "start": 227.0,
        "end": 228.0,
        "text": "谁怕谁"
    },
    {
        "start": 228.0,
        "end": 229.0,
        "text": "休息时间"
    },
    {
        "start": 229.0,
        "end": 231.0,
        "text": "我们东西也不吃"
    },
    {
        "start": 231.0,
        "end": 234.0,
        "text": "便到图书馆借书去了"
    },
    {
        "start": 234.0,
        "end": 235.0,
        "text": "我借了一本"
    },
    {
        "start": 235.0,
        "end": 237.0,
        "text": "快乐的小肥猪"
    },
    {
        "start": 237.0,
        "end": 240.0,
        "text": "阿火借了可怜的小猴子"
    },
    {
        "start": 240.0,
        "end": 243.0,
        "text": "韦韦看到这两本书的书名时"
    },
    {
        "start": 243.0,
        "end": 245.0,
        "text": "忍不住哈哈大笑"
    },
    {
        "start": 245.0,
        "end": 248.0,
        "text": "说书名很像我和阿火"
    },
    {
        "start": 250.0,
        "end": 251.0,
        "text": "这时"
    },
    {
        "start": 251.0,
        "end": 253.0,
        "text": "黄老师刚好经过"
    },
    {
        "start": 253.0,
        "end": 254.0,
        "text": "看见我们借书"
    },
    {
        "start": 254.0,
        "end": 256.0,
        "text": "十分安慰的说"
    },
    {
        "start": 256.0,
        "end": 258.0,
        "text": "看完了记得写读书报告哦"
    },
    {
        "start": 260.0,
        "end": 261.0,
        "text": "回到家"
    },
    {
        "start": 261.0,
        "end": 263.0,
        "text": "我翻开快乐的小肥猪"
    },
    {
        "start": 263.0,
        "end": 265.0,
        "text": "只读了一夜"
    },
    {
        "start": 265.0,
        "end": 267.0,
        "text": "便像猪那样的睡着了"
    },
    {
        "start": 267.0,
        "end": 269.0,
        "text": "我做了一个梦"
    },
    {
        "start": 269.0,
        "end": 270.0,
        "text": "梦里"
    },
    {
        "start": 270.0,
        "end": 272.0,
        "text": "我和故事中的小肥猪"
    },
    {
        "start": 272.0,
        "end": 275.0,
        "text": "想吃我最喜爱的草莓蛋糕"
    },
    {
        "start": 277.0,
        "end": 278.0,
        "text": "第二天"
    },
    {
        "start": 278.0,
        "end": 280.0,
        "text": "黄老师问我和阿火"
    },
    {
        "start": 280.0,
        "end": 282.0,
        "text": "你们有没有把书看完"
    },
    {
        "start": 282.0,
        "end": 284.0,
        "text": "我看到阿火举起手"
    },
    {
        "start": 284.0,
        "end": 286.0,
        "text": "也不甘示弱的举起手"
    },
    {
        "start": 287.0,
        "end": 288.0,
        "text": "这时"
    },
    {
        "start": 288.0,
        "end": 290.0,
        "text": "张鑫问了一个很笨的问题"
    },
    {
        "start": 290.0,
        "end": 291.0,
        "text": "闹闹"
    },
    {
        "start": 291.0,
        "end": 293.0,
        "text": "快乐的小肥猪"
    },
    {
        "start": 293.0,
        "end": 295.0,
        "text": "是个怎样的故事"
    },
    {
        "start": 295.0,
        "end": 296.0,
        "text": "我连忙回答"
    },
    {
        "start": 296.0,
        "end": 298.0,
        "text": "我借给你看"
    },
    {
        "start": 298.0,
        "end": 299.0,
        "text": "你就知道了"
    },
    {
        "start": 300.0,
        "end": 301.0,
        "text": "可惜"
    },
    {
        "start": 301.0,
        "end": 302.0,
        "text": "黄老师却说"
    },
    {
        "start": 302.0,
        "end": 304.0,
        "text": "我们就请闹闹上来"
    },
    {
        "start": 304.0,
        "end": 305.0,
        "text": "告诉大家"
    },
    {
        "start": 305.0,
        "end": 307.0,
        "text": "他昨天读的故事吧"
    },
    {
        "start": 309.0,
        "end": 310.0,
        "text": "完蛋了"
    },
    {
        "start": 310.0,
        "end": 311.0,
        "text": "我只读了一夜"
    },
    {
        "start": 311.0,
        "end": 313.0,
        "text": "怎么说故事呢"
    },
    {
        "start": 313.0,
        "end": 315.0,
        "text": "我紧张的走上前"
    },
    {
        "start": 315.0,
        "end": 317.0,
        "text": "决定随便吹牛"
    },
    {
        "start": 319.0,
        "end": 321.0,
        "text": "小肥猪"
    },
    {
        "start": 321.0,
        "end": 324.0,
        "text": "是一只很肥的猪"
    },
    {
        "start": 324.0,
        "end": 327.0,
        "text": "他很爱吃蛋糕"
    },
    {
        "start": 327.0,
        "end": 329.0,
        "text": "我小声的说"
    },
    {
        "start": 329.0,
        "end": 332.0,
        "text": "全班同学听了都哈哈大笑"
    },
    {
        "start": 334.0,
        "end": 337.0,
        "text": "他每天被朋友捉弄"
    },
    {
        "start": 337.0,
        "end": 340.0,
        "text": "所以他决定减肥"
    },
    {
        "start": 340.0,
        "end": 341.0,
        "text": "说完了"
    },
    {
        "start": 341.0,
        "end": 342.0,
        "text": "一说完"
    },
    {
        "start": 342.0,
        "end": 344.0,
        "text": "我赶快冲回座位"
    },
    {
        "start": 344.0,
        "end": 345.0,
        "text": "希望下课临生"
    },
    {
        "start": 345.0,
        "end": 347.0,
        "text": "快点响起"
    },
    {
        "start": 347.0,
        "end": 349.0,
        "text": "同学们没有机会发问"
    },
    {
        "start": 351.0,
        "end": 352.0,
        "text": "谁知道"
    },
    {
        "start": 352.0,
        "end": 354.0,
        "text": "这时候尾巴举起手"
    },
    {
        "start": 354.0,
        "end": 355.0,
        "text": "告诉老师"
    },
    {
        "start": 355.0,
        "end": 356.0,
        "text": "老师"
    },
    {
        "start": 356.0,
        "end": 358.0,
        "text": "我读过这本书"
    },
    {
        "start": 358.0,
        "end": 360.0,
        "text": "故事不是这样的"
    },
    {
        "start": 360.0,
        "end": 362.0,
        "text": "我瞪了尾巴一眼"
    },
    {
        "start": 362.0,
        "end": 363.0,
        "text": "心想"
    },
    {
        "start": 363.0,
        "end": 364.0,
        "text": "树呆子真讨厌"
    },
    {
        "start": 366.0,
        "end": 368.0,
        "text": "黄老师问我"
    },
    {
        "start": 368.0,
        "end": 369.0,
        "text": "闹闹"
    },
    {
        "start": 369.0,
        "end": 371.0,
        "text": "你为什么要骗大家"
    },
    {
        "start": 371.0,
        "end": 373.0,
        "text": "我低着头不敢回答"
    },
    {
        "start": 373.0,
        "end": 374.0,
        "text": "老师很生气"
    },
    {
        "start": 374.0,
        "end": 377.0,
        "text": "罚我把快乐的小肥猪的故事"
    },
    {
        "start": 377.0,
        "end": 378.0,
        "text": "抄写一遍"
    },
    {
        "start": 380.0,
        "end": 382.0,
        "text": "阿火比我幸运"
    },
    {
        "start": 382.0,
        "end": 384.0,
        "text": "黄老师叫他出来讲故事时"
    },
    {
        "start": 385.0,
        "end": 387.0,
        "text": "下课的临生响了"
    },
    {
        "start": 387.0,
        "end": 388.0,
        "text": "哎"
    },
    {
        "start": 388.0,
        "end": 389.0,
        "text": "阿火就好了"
    },
    {
        "start": 389.0,
        "end": 391.0,
        "text": "他做了快乐的小猴子"
    },
    {
        "start": 391.0,
        "end": 394.0,
        "text": "我就成了可怜的小肥猪"
    },
    {
        "start": 396.0,
        "end": 398.0,
        "text": "闹闹是阅读王"
    },
    {
        "start": 400.0,
        "end": 401.0,
        "text": "回到家里"
    },
    {
        "start": 401.0,
        "end": 402.0,
        "text": "我翻开故事书"
    },
    {
        "start": 402.0,
        "end": 404.0,
        "text": "乖乖的抄写"
    },
    {
        "start": 404.0,
        "end": 405.0,
        "text": "抄了几页后"
    },
    {
        "start": 405.0,
        "end": 408.0,
        "text": "我不知不觉被故事吸引住了"
    },
    {
        "start": 410.0,
        "end": 411.0,
        "text": "原来"
    },
    {
        "start": 411.0,
        "end": 414.0,
        "text": "小肥猪是一只脖角猪"
    },
    {
        "start": 414.0,
        "end": 417.0,
        "text": "虽然它常被其他动物戏弄"
    },
    {
        "start": 417.0,
        "end": 419.0,
        "text": "可是它不但不生气"
    },
    {
        "start": 419.0,
        "end": 423.0,
        "text": "还很热心的帮助那些取笑它的动物"
    },
    {
        "start": 425.0,
        "end": 426.0,
        "text": "这天"
    },
    {
        "start": 426.0,
        "end": 428.0,
        "text": "凶猛的狮子要吃小肥猪"
    },
    {
        "start": 428.0,
        "end": 432.0,
        "text": "被小肥猪帮助过的动物们都来救它"
    },
    {
        "start": 432.0,
        "end": 435.0,
        "text": "他们合力把狮子逼到海边"
    },
    {
        "start": 435.0,
        "end": 437.0,
        "text": "狮子一不小心"
    },
    {
        "start": 437.0,
        "end": 438.0,
        "text": "跌入了海里"
    },
    {
        "start": 440.0,
        "end": 442.0,
        "text": "狮子惊慌大叫"
    },
    {
        "start": 442.0,
        "end": 443.0,
        "text": "救命啊"
    },
    {
        "start": 443.0,
        "end": 444.0,
        "text": "救命啊"
    },
    {
        "start": 445.0,
        "end": 447.0,
        "text": "没有动物愿意救狮子"
    },
    {
        "start": 447.0,
        "end": 449.0,
        "text": "只有小肥猪"
    },
    {
        "start": 449.0,
        "end": 451.0,
        "text": "它伸出自己的拐杖"
    },
    {
        "start": 451.0,
        "end": 453.0,
        "text": "让狮子捉住"
    },
    {
        "start": 454.0,
        "end": 455.0,
        "text": "可是"
    },
    {
        "start": 455.0,
        "end": 458.0,
        "text": "小肥猪一时失去平衡"
    },
    {
        "start": 458.0,
        "end": 460.0,
        "text": "也跌入了海里"
    },
    {
        "start": 460.0,
        "end": 463.0,
        "text": "这时刚好有一条大鲨鱼游来"
    },
    {
        "start": 463.0,
        "end": 466.0,
        "text": "一口便把小肥猪吃掉了"
    },
    {
        "start": 466.0,
        "end": 468.0,
        "text": "小肥猪为了救狮子"
    },
    {
        "start": 468.0,
        "end": 470.0,
        "text": "牺牲了自己"
    },
    {
        "start": 470.0,
        "end": 472.0,
        "text": "我觉得好感动"
    },
    {
        "start": 472.0,
        "end": 474.0,
        "text": "小肥猪真伟大啊"
    },
    {
        "start": 476.0,
        "end": 478.0,
        "text": "我觉得这本书很好看"
    },
    {
        "start": 478.0,
        "end": 480.0,
        "text": "便带去找阿火"
    },
    {
        "start": 480.0,
        "end": 482.0,
        "text": "想介绍给他看"
    },
    {
        "start": 482.0,
        "end": 484.0,
        "text": "我到了阿火的家"
    },
    {
        "start": 484.0,
        "end": 486.0,
        "text": "正好看见他在手舞足蹈"
    },
    {
        "start": 486.0,
        "end": 488.0,
        "text": "啊啊啊的怪叫"
    },
    {
        "start": 490.0,
        "end": 492.0,
        "text": "阿火你在干什么"
    },
    {
        "start": 492.0,
        "end": 493.0,
        "text": "我好奇的问"
    },
    {
        "start": 493.0,
        "end": 494.0,
        "text": "阿火回答"
    },
    {
        "start": 494.0,
        "end": 495.0,
        "text": "我在打蟑螂"
    },
    {
        "start": 495.0,
        "end": 496.0,
        "text": "死蟑螂"
    },
    {
        "start": 496.0,
        "end": 498.0,
        "text": "看你还能往哪儿跑"
    },
    {
        "start": 498.0,
        "end": 499.0,
        "text": "说完"
    },
    {
        "start": 499.0,
        "end": 501.0,
        "text": "阿火把我手里的书抢了过去"
    },
    {
        "start": 501.0,
        "end": 503.0,
        "text": "大力往墙上一丢"
    },
    {
        "start": 505.0,
        "end": 506.0,
        "text": "喂我的书"
    },
    {
        "start": 506.0,
        "end": 508.0,
        "text": "我连忙把书拾起来"
    },
    {
        "start": 508.0,
        "end": 509.0,
        "text": "一只死蟑螂"
    },
    {
        "start": 509.0,
        "end": 511.0,
        "text": "粘在书的封面"
    },
    {
        "start": 511.0,
        "end": 513.0,
        "text": "掉下来的翅膀"
    },
    {
        "start": 513.0,
        "end": 515.0,
        "text": "成了小肥猪的胡子"
    },
    {
        "start": 515.0,
        "end": 517.0,
        "text": "阿火笑说"
    },
    {
        "start": 517.0,
        "end": 519.0,
        "text": "哈哈你的书真有用"
    },
    {
        "start": 519.0,
        "end": 520.0,
        "text": "我对阿火说"
    },
    {
        "start": 520.0,
        "end": 522.0,
        "text": "这本书很好看"
    },
    {
        "start": 522.0,
        "end": 524.0,
        "text": "原来看书一点也不闷"
    },
    {
        "start": 524.0,
        "end": 526.0,
        "text": "阿火高兴的对我说"
    },
    {
        "start": 526.0,
        "end": 527.0,
        "text": "太好了太好了"
    },
    {
        "start": 527.0,
        "end": 529.0,
        "text": "那么以后你就帮我看书"
    },
    {
        "start": 529.0,
        "end": 531.0,
        "text": "帮我写读书报告吧"
    },
    {
        "start": 533.0,
        "end": 535.0,
        "text": "想到热心助人的小肥猪"
    },
    {
        "start": 535.0,
        "end": 537.0,
        "text": "我答应了阿火"
    },
    {
        "start": 537.0,
        "end": 539.0,
        "text": "每天休息的时候"
    },
    {
        "start": 539.0,
        "end": 542.0,
        "text": "我便和伟伟一起去图书馆借书"
    },
    {
        "start": 542.0,
        "end": 543.0,
        "text": "看书"
    },
    {
        "start": 543.0,
        "end": 545.0,
        "text": "伟伟说的对"
    },
    {
        "start": 545.0,
        "end": 547.0,
        "text": "看书不应该为了礼物"
    },
    {
        "start": 549.0,
        "end": 550.0,
        "text": "这天"
    },
    {
        "start": 550.0,
        "end": 552.0,
        "text": "阿火叫我陪他去买"
    },
    {
        "start": 552.0,
        "end": 554.0,
        "text": "最新的日常书"
    },
    {
        "start": 554.0,
        "end": 556.0,
        "text": "我陪他去买最新的"
    },
    {
        "start": 556.0,
        "end": 558.0,
        "text": "日本卡通片光碟"
    },
    {
        "start": 558.0,
        "end": 560.0,
        "text": "阿火买了很多光碟"
    },
    {
        "start": 560.0,
        "end": 562.0,
        "text": "我们走出来的时候"
    },
    {
        "start": 562.0,
        "end": 563.0,
        "text": "一不小心"
    },
    {
        "start": 563.0,
        "end": 566.0,
        "text": "拿带光碟掉在一个人的脚上"
    },
    {
        "start": 568.0,
        "end": 569.0,
        "text": "哎呦"
    },
    {
        "start": 569.0,
        "end": 572.0,
        "text": "一个满头红发的哥哥痛叫一声"
    },
    {
        "start": 572.0,
        "end": 573.0,
        "text": "我连忙道歉"
    },
    {
        "start": 573.0,
        "end": 575.0,
        "text": "对不起对不起"
    },
    {
        "start": 575.0,
        "end": 577.0,
        "text": "红发哥哥生气的说"
    },
    {
        "start": 577.0,
        "end": 579.0,
        "text": "你是故意的"
    },
    {
        "start": 579.0,
        "end": 581.0,
        "text": "说完他大力一推"
    },
    {
        "start": 581.0,
        "end": 583.0,
        "text": "把我推倒在地上"
    },
    {
        "start": 584.0,
        "end": 585.0,
        "text": "喂"
    },
    {
        "start": 585.0,
        "end": 586.0,
        "text": "你为什么打人"
    },
    {
        "start": 586.0,
        "end": 588.0,
        "text": "阿火生气的"
    },
    {
        "start": 588.0,
        "end": 591.0,
        "text": "学卡通片里的英雄摆出姿势"
    },
    {
        "start": 591.0,
        "end": 593.0,
        "text": "准备与红发哥哥打起来"
    },
    {
        "start": 593.0,
        "end": 596.0,
        "text": "怎知红发哥哥轻轻一推"
    },
    {
        "start": 596.0,
        "end": 599.0,
        "text": "阿火便跌了个四脚朝天"
    },
    {
        "start": 599.0,
        "end": 601.0,
        "text": "比我还糟糕"
    },
    {
        "start": 603.0,
        "end": 605.0,
        "text": "以后给我小心点"
    },
    {
        "start": 605.0,
        "end": 606.0,
        "text": "说完"
    },
    {
        "start": 606.0,
        "end": 609.0,
        "text": "红发哥哥便骑上脚踏车离开"
    },
    {
        "start": 609.0,
        "end": 611.0,
        "text": "阿火生气的说"
    },
    {
        "start": 611.0,
        "end": 613.0,
        "text": "如果我有越野脚踏车"
    },
    {
        "start": 613.0,
        "end": 615.0,
        "text": "我一定追上他"
    },
    {
        "start": 615.0,
        "end": 616.0,
        "text": "我对阿火说"
    },
    {
        "start": 616.0,
        "end": 617.0,
        "text": "算了"
    },
    {
        "start": 617.0,
        "end": 619.0,
        "text": "我们要学小肥猪"
    },
    {
        "start": 619.0,
        "end": 620.0,
        "text": "原谅别人"
    },
    {
        "start": 620.0,
        "end": 622.0,
        "text": "这样才会快乐"
    },
    {
        "start": 622.0,
        "end": 624.0,
        "text": "阿火不高兴的说"
    },
    {
        "start": 624.0,
        "end": 625.0,
        "text": "被人欺负了"
    },
    {
        "start": 625.0,
        "end": 627.0,
        "text": "怎么快乐"
    },
    {
        "start": 628.0,
        "end": 630.0,
        "text": "阿火把我扶起来"
    },
    {
        "start": 630.0,
        "end": 632.0,
        "text": "我的脚受伤了"
    },
    {
        "start": 632.0,
        "end": 634.0,
        "text": "走路一拐一拐的"
    },
    {
        "start": 634.0,
        "end": 636.0,
        "text": "很像小肥猪"
    },
    {
        "start": 636.0,
        "end": 638.0,
        "text": "我们经过沟渠时"
    },
    {
        "start": 638.0,
        "end": 641.0,
        "text": "忽然听到有人大声喊叫"
    },
    {
        "start": 641.0,
        "end": 642.0,
        "text": "救命啊"
    },
    {
        "start": 642.0,
        "end": 644.0,
        "text": "救命啊"
    },
    {
        "start": 646.0,
        "end": 647.0,
        "text": "我们低头一看"
    },
    {
        "start": 647.0,
        "end": 652.0,
        "text": "原来红发哥哥和他的脚踏车掉进水沟里了"
    },
    {
        "start": 652.0,
        "end": 654.0,
        "text": "他的脚还流着血"
    },
    {
        "start": 654.0,
        "end": 656.0,
        "text": "阿火拍手大笑"
    },
    {
        "start": 656.0,
        "end": 657.0,
        "text": "开心的说"
    },
    {
        "start": 657.0,
        "end": 658.0,
        "text": "真是活该"
    },
    {
        "start": 658.0,
        "end": 660.0,
        "text": "闹闹别理他"
    },
    {
        "start": 662.0,
        "end": 664.0,
        "text": "看见红发哥哥可怜的模样"
    },
    {
        "start": 664.0,
        "end": 666.0,
        "text": "我也觉得很痛快"
    },
    {
        "start": 666.0,
        "end": 668.0,
        "text": "但不知为什么"
    },
    {
        "start": 668.0,
        "end": 670.0,
        "text": "我突然想起小肥猪"
    },
    {
        "start": 670.0,
        "end": 672.0,
        "text": "于是我对阿火说"
    },
    {
        "start": 672.0,
        "end": 674.0,
        "text": "我们原谅他吧"
    },
    {
        "start": 674.0,
        "end": 676.0,
        "text": "说着我伸出双手"
    },
    {
        "start": 676.0,
        "end": 678.0,
        "text": "把红发哥哥拉了上来"
    },
    {
        "start": 680.0,
        "end": 682.0,
        "text": "红发哥哥很不好意思"
    },
    {
        "start": 682.0,
        "end": 684.0,
        "text": "匆匆的向我们道谢"
    },
    {
        "start": 684.0,
        "end": 687.0,
        "text": "然后骑着脚踏车走了"
    },
    {
        "start": 687.0,
        "end": 689.0,
        "text": "阿火不明白"
    },
    {
        "start": 689.0,
        "end": 692.0,
        "text": "为什么我还要帮助红发哥哥"
    },
    {
        "start": 692.0,
        "end": 694.0,
        "text": "我愉快的告诉他"
    },
    {
        "start": 694.0,
        "end": 696.0,
        "text": "因为帮助别人"
    },
    {
        "start": 696.0,
        "end": 698.0,
        "text": "自己也会快乐"
    },
    {
        "start": 700.0,
        "end": 702.0,
        "text": "很快的一个月过去了"
    },
    {
        "start": 702.0,
        "end": 705.0,
        "text": "今天黄老师想全班宣布"
    },
    {
        "start": 705.0,
        "end": 708.0,
        "text": "这个月的阅读小博士是阿火"
    },
    {
        "start": 708.0,
        "end": 711.0,
        "text": "我们要向阿火多多学习"
    },
    {
        "start": 711.0,
        "end": 712.0,
        "text": "多看书"
    },
    {
        "start": 712.0,
        "end": 714.0,
        "text": "学习做人的道理"
    },
    {
        "start": 714.0,
        "end": 716.0,
        "text": "同学们都热烈鼓掌"
    },
    {
        "start": 716.0,
        "end": 719.0,
        "text": "阿火很不好意思"
    },
    {
        "start": 719.0,
        "end": 721.0,
        "text": "吞吞吐吐的对老师说"
    },
    {
        "start": 721.0,
        "end": 727.0,
        "text": "老师其实真正的阅读小博士是"
    },
    {
        "start": 727.0,
        "end": 730.0,
        "text": "是闹闹不是我"
    },
    {
        "start": 730.0,
        "end": 734.0,
        "text": "阿火把事情一五一十的告诉黄老师"
    },
    {
        "start": 734.0,
        "end": 737.0,
        "text": "老师请把礼物给闹闹吧"
    },
    {
        "start": 739.0,
        "end": 742.0,
        "text": "黄老师拿出一份礼物交给我"
    },
    {
        "start": 742.0,
        "end": 744.0,
        "text": "我打开礼物一看"
    },
    {
        "start": 744.0,
        "end": 747.0,
        "text": "原来是十本课外书"
    },
    {
        "start": 747.0,
        "end": 748.0,
        "text": "阿火很失望"
    },
    {
        "start": 748.0,
        "end": 751.0,
        "text": "说原来不是脚踏车"
    },
    {
        "start": 751.0,
        "end": 754.0,
        "text": "我却感到心怀怒放"
    },
    {
        "start": 754.0,
        "end": 759.0,
        "text": "因为我觉得这份礼物比月爷脚踏车还好呢"
    }
]